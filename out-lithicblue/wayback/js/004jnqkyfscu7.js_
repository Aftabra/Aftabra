;!function(){try { var e="undefined"!=typeof globalThis?globalThis:"undefined"!=typeof global?global:"undefined"!=typeof window?window:"undefined"!=typeof self?self:{},n=(new e.Error).stack;n&&((e._debugIds|| (e._debugIds={}))[n]="00a2dfcd-15cc-7e92-5475-a4531371849d")}catch(e){}}();
(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,621993,(e,t,o)=>{t.exports=JSON.parse('[{"label":"Title Slide","elements":[{"id":"ets-bg-1","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":13.33,"h":7.5,"fill":{"type":"solid","color":"1a365d"}},{"id":"ets-accent-1","type":"line","x":0.8,"y":1.8,"w":3,"h":0,"style":{"borderWidth":3,"borderColor":"38b2ac"}},{"id":"ets-title-1","type":"shape","x":0.8,"y":2,"w":11.73,"h":2.5,"textRuns":[{"text":"Net Zero Transition Pathway\\n& Investment Case","fontSize":36,"bold":true,"color":"ffffff"}],"style":{"align":"left","valign":"top"}},{"id":"ets-subtitle-1","type":"shape","x":0.8,"y":4.8,"w":11.73,"h":0.6,"textRuns":[{"text":"Independent Strategic Review — Confidential","fontSize":16,"color":"a0aec0"}],"style":{"align":"left"}},{"id":"ets-footer-1","type":"shape","x":0.8,"y":6,"w":11.73,"h":0.8,"textRuns":[{"text":"Prepared for Northpoint Energy plc\\nby Helix Strategic Advisory LLP  |  March 2025","fontSize":13,"color":"718096"}],"style":{"align":"left"}},{"id":"ets-logo-0","type":"shape","shapeType":"rectangle","x":10.33,"y":0.5,"w":2.5,"h":1.0,"fill":{"type":"image","src":"/demo-logos/helix-strategic-advisory.svg","sizing":"contain"}}]},{"label":"Executive Summary","elements":[{"id":"ets-header-2","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"Executive Summary","fontSize":28,"bold":true,"color":"1a365d"}],"style":{"align":"left","valign":"bottom"}},{"id":"ets-line-2","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"e2e8f0"}},{"id":"ets-body-2a","type":"shape","x":0.5,"y":1.5,"w":5.9,"h":5.5,"textRuns":[{"text":"Current Position\\n","fontSize":16,"bold":true,"color":"1a365d"},{"text":"\\nNorthpoint Energy operates a 1.2 GW generation portfolio serving 2.1 million customers. Renewables currently account for 28% of capacity (340 MW), up from 19% three years ago.\\n\\nRevenue grew 4.9% to £600M in FY2024. Carbon emissions reduced 14% to 1.8 Mt CO2e from the 2022 baseline. The company achieved CDP Climate score B and SBTi-validated targets.\\n\\nHowever, the pace of transition must accelerate significantly to meet the 42% Scope 1&2 reduction target by 2030.","fontSize":12,"color":"4a5568"}],"style":{"align":"left","valign":"top"},"sources":[{"url":"Annual_Report_2024.md","location":{"section":"Chairman\'s Statement","excerpt":"renewable sources now account for 28% of our 1.2 GW generation portfolio, up from 19% three years ago"}},{"url":"Net_Zero_Strategy_2023-2030.md","location":{"section":"Targets and Trajectory","excerpt":"Scope 1+2 reduction | 42% from 2022 baseline | By 2030"}}]},{"id":"ets-body-2b","type":"shape","x":6.9,"y":1.5,"w":5.93,"h":5.5,"textRuns":[{"text":"Investment Required\\n","fontSize":16,"bold":true,"color":"1a365d"},{"text":"\\nTotal estimated investment of £1.2 billion over 2025–2035 across four workstreams:\\n\\n• Renewable generation expansion\\n• Grid modernisation (RIIO-ED2)\\n• EV charging infrastructure (5,000 points)\\n• Customer decarbonisation programmes\\n\\nProject Boreas (200 MW offshore wind) and Project Solaris (150 MW solar) represent £480M of committed capital. The Solway CCGT (120 MW) is approaching end of economic life with review scheduled for 2026.","fontSize":12,"color":"4a5568"}],"style":{"align":"left","valign":"top"},"sources":[{"url":"Annual_Report_2024.md","location":{"section":"Outlook","excerpt":"total investment of approximately £1.2 billion over the period 2025-2035 across renewable generation, grid modernisation, EV infrastructure, and customer programmes"}},{"url":"Renewable_Energy_Integration_Roadmap.md","location":{"section":"Committed Projects","excerpt":"Project Boreas — Offshore Wind (200 MW)"}},{"url":"Board_Paper_Q2_Capital_Investment_Approval.md","location":{"section":"Project Boreas — Expenditure Update","excerpt":"Project Boreas remains on budget at £480M total project cost"}}]},{"id":"ets-logo-1","type":"shape","shapeType":"rectangle","x":11.83,"y":6.9,"w":1.0,"h":0.4,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/helix-strategic-advisory.svg","sizing":"contain"}}]},{"label":"Generation Portfolio Assessment","elements":[{"id":"ets-header-3","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"Generation Portfolio — Current vs. Target Mix","fontSize":28,"bold":true,"color":"1a365d"}],"style":{"align":"left","valign":"bottom"}},{"id":"ets-line-3","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"e2e8f0"}},{"id":"ets-table-3","type":"table","x":0.5,"y":1.5,"w":12.33,"h":3.5,"tableData":{"rows":[{"cells":[{"text":"Source","textRuns":[{"text":"Source","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Current (MW)","textRuns":[{"text":"Current (MW)","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"% of Total","textRuns":[{"text":"% of Total","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Capacity Factor","textRuns":[{"text":"Capacity Factor","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"2030 Target (MW)","textRuns":[{"text":"2030 Target (MW)","bold":true,"fontSize":11,"color":"ffffff"}]}]},{"cells":[{"text":"Gas (CCGT)","textRuns":[{"text":"Gas (CCGT)","fontSize":11}]},{"text":"624","textRuns":[{"text":"624","fontSize":11}]},{"text":"52%","textRuns":[{"text":"52%","fontSize":11}]},{"text":"60%","textRuns":[{"text":"60%","fontSize":11}]},{"text":"504","textRuns":[{"text":"504","fontSize":11}]}]},{"cells":[{"text":"Nuclear (PPA)","textRuns":[{"text":"Nuclear (PPA)","fontSize":11}]},{"text":"240","textRuns":[{"text":"240","fontSize":11}]},{"text":"20%","textRuns":[{"text":"20%","fontSize":11}]},{"text":"87%","textRuns":[{"text":"87%","fontSize":11}]},{"text":"240","textRuns":[{"text":"240","fontSize":11}]}]},{"cells":[{"text":"Onshore Wind","textRuns":[{"text":"Onshore Wind","fontSize":11}]},{"text":"156","textRuns":[{"text":"156","fontSize":11}]},{"text":"13%","textRuns":[{"text":"13%","fontSize":11}]},{"text":"30%","textRuns":[{"text":"30%","fontSize":11}]},{"text":"280","textRuns":[{"text":"280","fontSize":11}]}]},{"cells":[{"text":"Offshore Wind","textRuns":[{"text":"Offshore Wind","fontSize":11}]},{"text":"60","textRuns":[{"text":"60","fontSize":11}]},{"text":"5%","textRuns":[{"text":"5%","fontSize":11}]},{"text":"40%","textRuns":[{"text":"40%","fontSize":11}]},{"text":"360","textRuns":[{"text":"360","fontSize":11}]}]},{"cells":[{"text":"Solar","textRuns":[{"text":"Solar","fontSize":11}]},{"text":"84","textRuns":[{"text":"84","fontSize":11}]},{"text":"7%","textRuns":[{"text":"7%","fontSize":11}]},{"text":"12%","textRuns":[{"text":"12%","fontSize":11}]},{"text":"334","textRuns":[{"text":"334","fontSize":11}]}]},{"cells":[{"text":"Hydro","textRuns":[{"text":"Hydro","fontSize":11}]},{"text":"40","textRuns":[{"text":"40","fontSize":11}]},{"text":"3%","textRuns":[{"text":"3%","fontSize":11}]},{"text":"41%","textRuns":[{"text":"41%","fontSize":11}]},{"text":"40","textRuns":[{"text":"40","fontSize":11}]}]}],"headerRow":true,"headerStyle":{"backgroundColor":"1a365d"}},"sources":[{"url":"Annual_Report_2024.md","location":{"section":"Operating Review — Generation","excerpt":"| Gas (CCGT) | 624 | 52% | 3,280 | 60% |"}},{"url":"Net_Zero_Strategy_2023-2030.md","location":{"section":"Pillar 1: Clean Generation","excerpt":"Our generation strategy is to reach 65% renewable generation by 2030"}},{"url":"Renewable_Energy_Integration_Roadmap.md","location":{"section":"Target Portfolio (2030)","excerpt":"| Offshore wind | 560 | 31% |"}}]},{"id":"ets-callout-3","type":"shape","shapeType":"rounded-rect","x":0.5,"y":5.3,"w":12.33,"h":1.7,"fill":{"type":"solid","color":"ebf8ff"},"textRuns":[{"text":"Key Insight: ","fontSize":12,"bold":true,"color":"2b6cb0"},{"text":"Renewable capacity must grow from 340 MW (28%) to ~1,014 MW (57%) by 2030 to meet SBTi targets. This requires successful delivery of Projects Boreas and Solaris, plus 264 MW of additional committed projects — a 3x increase in renewable capacity over six years. The nuclear PPA (240 MW, expiring 2034) provides critical low-carbon baseload during transition.","fontSize":11,"color":"2c5282"}],"style":{"align":"left","valign":"middle","padding":12},"sources":[{"url":"Net_Zero_Strategy_2023-2030.md","location":{"section":"Pillar 1: Clean Generation — Nuclear PPA","excerpt":"The EDF Sizewell PPA (240 MW) provides reliable low-carbon baseload generation through to March 2034"}},{"url":"Investor_Presentation_H2_2024.md","location":{"section":"Generation Portfolio Evolution","excerpt":"Renewable capacity at 340 MW (28% of portfolio), on track for 65% by 2030"}}]},{"id":"ets-logo-2","type":"shape","shapeType":"rectangle","x":11.83,"y":6.9,"w":1.0,"h":0.4,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/helix-strategic-advisory.svg","sizing":"contain"}}]},{"label":"Grid Modernisation & Customer Readiness","elements":[{"id":"ets-header-4","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"Grid Modernisation & Customer Readiness","fontSize":28,"bold":true,"color":"1a365d"}],"style":{"align":"left","valign":"bottom"}},{"id":"ets-line-4","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"e2e8f0"}},{"id":"ets-kpi-4a","type":"shape","shapeType":"rounded-rect","x":0.5,"y":1.5,"w":3.8,"h":1.8,"fill":{"type":"solid","color":"f0fff4"},"stroke":{"width":1,"color":"c6f6d5","style":"solid"},"textRuns":[{"text":"62%\\n","fontSize":32,"bold":true,"color":"276749"},{"text":"Smart Meter\\nPenetration\\n","fontSize":12,"color":"276749"},{"text":"(up from 48% FY2023)","fontSize":10,"color":"68d391"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Annual_Report_2024.md","location":{"section":"Chief Executive\'s Review — Grid Modernisation","excerpt":"Smart meter penetration reached 62% across our service territory, up from 48% in FY2023"}}]},{"id":"ets-kpi-4b","type":"shape","shapeType":"rounded-rect","x":4.76,"y":1.5,"w":3.8,"h":1.8,"fill":{"type":"solid","color":"fffff0"},"stroke":{"width":1,"color":"fefcbf","style":"solid"},"textRuns":[{"text":"450\\n","fontSize":32,"bold":true,"color":"975a16"},{"text":"EV Charge Points\\nInstalled\\n","fontSize":12,"color":"975a16"},{"text":"(target: 5,000 by 2030)","fontSize":10,"color":"d69e2e"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Annual_Report_2024.md","location":{"section":"Chief Executive\'s Review — EV Infrastructure","excerpt":"The ChargePoint North programme installed 450 public charging points across our territory by year-end, against a target of 5,000 by 2030"}},{"url":"Grid_Modernisation_Programme_Plan.md","location":{"section":"Network Capacity Forecast","excerpt":"| EV charging | 85 MW | 320 MW | 580 MW |"}}]},{"id":"ets-kpi-4c","type":"shape","shapeType":"rounded-rect","x":9.03,"y":1.5,"w":3.8,"h":1.8,"fill":{"type":"solid","color":"ebf8ff"},"stroke":{"width":1,"color":"bee3f8","style":"solid"},"textRuns":[{"text":"£38M\\n","fontSize":32,"bold":true,"color":"2b6cb0"},{"text":"Grid Investment\\nFY2024\\n","fontSize":12,"color":"2b6cb0"},{"text":"(network + smart grid)","fontSize":10,"color":"63b3ed"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Annual_Report_2024.md","location":{"section":"Chief Executive\'s Review — Grid Modernisation","excerpt":"We invested £38 million in network reinforcement and smart grid technology during the year"}}]},{"id":"ets-findings-4","type":"shape","x":0.5,"y":3.6,"w":6,"h":3.5,"textRuns":[{"text":"Grid Modernisation Progress\\n\\n","fontSize":16,"bold":true,"color":"1a365d"},{"text":"• ADMS rollout completed across northern network\\n• GridFlex programme on track vs RIIO-ED2 plan\\n• £95M total capex in FY2024 (+15.9% YoY)\\n• Network reinforcement critical for renewable integration\\n• Battery storage strategy still under development\\n\\n","fontSize":11,"color":"4a5568"},{"text":"Risk: Grid constraints identified in three substation zones could delay renewable connections by 12–18 months without accelerated reinforcement investment.","fontSize":11,"italic":true,"color":"c53030"}],"style":{"align":"left","valign":"top"},"sources":[{"url":"Grid_Modernisation_Programme_Plan.md","location":{"section":"Programme Workstreams — ADMS","excerpt":"Phase 1 (Northern area): Completed Q4 FY2024. Covers 55% of network by customer connections."}},{"url":"Board_Paper_Q3_Energy_Transition_Review.md","location":{"section":"Grid Modernisation — GridFlex Update","excerpt":"Overall programme status: AMBER"}}]},{"id":"ets-findings-4b","type":"shape","x":6.9,"y":3.6,"w":5.93,"h":3.5,"textRuns":[{"text":"Customer Programmes\\n\\n","fontSize":16,"bold":true,"color":"1a365d"},{"text":"• GreenHome: 4,200 customers supported (heat pumps, insulation, solar)\\n• Green tariff customers grew 34% to 185,000\\n• EV utilisation at 18%, above 12–15% benchmark\\n• ChargePoint North on track but 9% of 2030 target\\n\\n","fontSize":11,"color":"4a5568"},{"text":"\\"The customer decarbonisation opportunity is immense, but our current run-rate won\'t deliver the 2030 targets. We need to move from pilot to scale.\\"\\n— CEO Interview, Jan 2025","fontSize":11,"italic":true,"color":"718096"}],"style":{"align":"left","valign":"top"},"sources":[{"url":"Annual_Report_2024.md","location":{"section":"Chief Executive\'s Review — Customer Decarbonisation","excerpt":"The GreenHome programme supported 4,200 domestic customers with heat pump installations, insulation upgrades, and rooftop solar during FY2024"}},{"url":"CEO_Interview_Jan2025.md","location":{"section":"Customer Engagement","excerpt":"The GreenHome programme is going well — Laura Jennings has done good work. But it\'s reaching maybe 5,000 customers a year. We\'ve got 1.75 million residential customers."}},{"url":"COO_Interview_Jan2025.md","location":{"section":"EV Charging Impact","excerpt":"Tom\'s target is 5,000 chargers by 2030. My concern is whether we have the grid capacity for 5,000 chargers plus all the household chargers"}}]},{"id":"ets-logo-3","type":"shape","shapeType":"rectangle","x":11.83,"y":6.9,"w":1.0,"h":0.4,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/helix-strategic-advisory.svg","sizing":"contain"}}]},{"label":"Strategic Recommendations","elements":[{"id":"ets-header-5","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"Strategic Recommendations","fontSize":28,"bold":true,"color":"1a365d"}],"style":{"align":"left","valign":"bottom"}},{"id":"ets-line-5","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"e2e8f0"}},{"id":"ets-rec-5a","type":"shape","shapeType":"rounded-rect","x":0.5,"y":1.5,"w":5.9,"h":2.5,"fill":{"type":"solid","color":"f7fafc"},"stroke":{"width":1,"color":"e2e8f0","style":"solid"},"textRuns":[{"text":"1  ","fontSize":24,"bold":true,"color":"38b2ac"},{"text":"Accelerate Renewable Pipeline\\n\\n","fontSize":14,"bold":true,"color":"1a365d"},{"text":"Fast-track Project Boreas (200 MW) and Solaris (150 MW) timelines. Commission feasibility studies for additional 264 MW capacity to bridge the 2030 gap. Consider strategic partnerships for offshore wind development.","fontSize":11,"color":"4a5568"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Net_Zero_Strategy_2023-2030.md","location":{"section":"Pillar 1: Clean Generation — Renewable Build-Out","excerpt":"Project Boreas: 200 MW offshore wind (Dogger Bank area), FID September 2023, commissioning 2027-28"}},{"url":"Renewable_Energy_Integration_Roadmap.md","location":{"section":"Committed Projects — Project Solaris","excerpt":"Project Solaris — Solar (150 MW)"}}]},{"id":"ets-rec-5b","type":"shape","shapeType":"rounded-rect","x":6.9,"y":1.5,"w":5.93,"h":2.5,"fill":{"type":"solid","color":"f7fafc"},"stroke":{"width":1,"color":"e2e8f0","style":"solid"},"textRuns":[{"text":"2  ","fontSize":24,"bold":true,"color":"38b2ac"},{"text":"De-Risk Grid Bottlenecks\\n\\n","fontSize":14,"bold":true,"color":"1a365d"},{"text":"Prioritise reinforcement at the three constrained substation zones. Accelerate battery storage strategy — essential for managing renewable intermittency. Target ADMS completion across the full network by FY2026.","fontSize":11,"color":"4a5568"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Grid_Modernisation_Programme_Plan.md","location":{"section":"Network Capacity Forecast","excerpt":"Without intervention, 38% of our feeders face thermal constraints by 2030"}},{"url":"Risk_Register_Energy_Transition.md","location":{"section":"ETR-003: Grid Connection Delays","excerpt":"National Grid ESO connection queue delays push back commissioning dates for new renewable generation and storage projects"}}]},{"id":"ets-rec-5c","type":"shape","shapeType":"rounded-rect","x":0.5,"y":4.3,"w":5.9,"h":2.5,"fill":{"type":"solid","color":"f7fafc"},"stroke":{"width":1,"color":"e2e8f0","style":"solid"},"textRuns":[{"text":"3  ","fontSize":24,"bold":true,"color":"38b2ac"},{"text":"Develop Solway Exit Strategy\\n\\n","fontSize":14,"bold":true,"color":"1a365d"},{"text":"The 120 MW Solway CCGT (commissioned 2002) is approaching end of economic life. Develop closure plan with replacement capacity from renewables + storage. Engage Ofgem early on decommissioning timeline and network impact.","fontSize":11,"color":"4a5568"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Annual_Report_2024.md","location":{"section":"Operating Review — Generation","excerpt":"Solway (120 MW, commissioned 2002) — operated at an average capacity factor of 60%. The Solway plant is approaching end of economic life and is scheduled for review in 2026."}},{"url":"Board_Paper_Q3_Energy_Transition_Review.md","location":{"section":"Generation Portfolio Update — Gas Fleet","excerpt":"Independent engineering assessment recommends £8M in refurbishment for continued operation beyond 2027, or closure by March 2028"}}]},{"id":"ets-rec-5d","type":"shape","shapeType":"rounded-rect","x":6.9,"y":4.3,"w":5.93,"h":2.5,"fill":{"type":"solid","color":"f7fafc"},"stroke":{"width":1,"color":"e2e8f0","style":"solid"},"textRuns":[{"text":"4  ","fontSize":24,"bold":true,"color":"38b2ac"},{"text":"Strengthen Funding Strategy\\n\\n","fontSize":14,"bold":true,"color":"1a365d"},{"text":"£1.2B investment over 2025–2035 requires a blended funding approach. Current leverage (3.7x EBITDA) is at the upper end of comfort. Explore green bond issuance, infrastructure fund partnerships, and RIIO-ED2 allowance optimisation.","fontSize":11,"color":"4a5568"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Annual_Report_2024.md","location":{"section":"Financial Performance","excerpt":"Net Debt / EBITDA | 3.7x | 3.7x"}},{"url":"Investor_Presentation_H2_2024.md","location":{"section":"Financial Framework for the Transition","excerpt":"Estimated total transition investment: **£1.2 billion** (2025-2035)"}},{"url":"Sustainability_Committee_Minutes_Oct2024.md","location":{"section":"Independent Review — Helix Strategic Advisory","excerpt":"Helix Strategic Advisory has been engaged to conduct an independent review of Northpoint\'s net zero transition pathway and investment case"}}]},{"id":"ets-logo-4","type":"shape","shapeType":"rectangle","x":11.83,"y":6.9,"w":1.0,"h":0.4,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/helix-strategic-advisory.svg","sizing":"contain"}}]}]')},51134,(e,t,o)=>{t.exports=JSON.parse('[{"label":"Title Slide","elements":[{"id":"fsc-bg-1","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":13.33,"h":7.5,"fill":{"type":"solid","color":"3d1520"}},{"id":"fsc-accent-1","type":"line","x":1.5,"y":4.5,"w":10.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"c9a84c"}},{"id":"fsc-title-1","type":"shape","x":0.8,"y":2,"w":11.73,"h":2.5,"textRuns":[{"text":"Consumer Duty Compliance\\nReadiness Assessment","fontSize":36,"bold":true,"color":"ffffff"}],"style":{"align":"center","valign":"top"}},{"id":"fsc-subtitle-1","type":"shape","x":0.8,"y":4.8,"w":11.73,"h":0.6,"textRuns":[{"text":"Independent Regulatory Review — Confidential","fontSize":16,"color":"a0aec0"}],"style":{"align":"center"}},{"id":"fsc-footer-1","type":"shape","x":0.8,"y":6,"w":11.73,"h":0.8,"textRuns":[{"text":"Prepared for Hargreave Ellison Wealth Management Ltd\\nby Thornfield Regulatory Consulting LLP  |  March 2025","fontSize":13,"color":"718096"}],"style":{"align":"center"}},{"id":"fsc-logo-0","type":"shape","shapeType":"rectangle","x":5.42,"y":6.2,"w":2.5,"h":0.8,"fill":{"type":"image","src":"/demo-logos/ashworth-reid-advisory.svg","sizing":"contain"}}]},{"label":"Compliance Landscape","elements":[{"id":"fsc-header-2","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"Consumer Duty — Current Compliance Position","fontSize":28,"bold":true,"color":"7b2d3b"}],"style":{"align":"left","valign":"bottom"}},{"id":"fsc-line-2","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"e2e8f0"}},{"id":"fsc-gold-1","type":"line","x":0.5,"y":1.25,"w":3,"h":0,"style":{"borderWidth":1.5,"borderColor":"c9a84c"}},{"id":"fsc-kpi-2a","type":"shape","shapeType":"rounded-rect","x":0.5,"y":1.5,"w":2.88,"h":1.8,"fill":{"type":"solid","color":"fff5f5"},"stroke":{"width":1,"color":"fed7d7","style":"solid"},"textRuns":[{"text":"14.8%\\n","fontSize":28,"bold":true,"color":"c53030"},{"text":"Complaints\\nIncrease YoY","fontSize":11,"color":"c53030"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Annual_Report_FY2024.md","location":{"section":"Financial Highlights","excerpt":"Complaints (total) | 342 | 298 | +14.8%"}}]},{"id":"fsc-kpi-2b","type":"shape","shapeType":"rounded-rect","x":3.72,"y":1.5,"w":2.88,"h":1.8,"fill":{"type":"solid","color":"fff5f5"},"stroke":{"width":1,"color":"fed7d7","style":"solid"},"textRuns":[{"text":"48%\\n","fontSize":28,"bold":true,"color":"c53030"},{"text":"Complaints\\nUpheld Rate","fontSize":11,"color":"c53030"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Annual_Report_FY2024.md","location":{"section":"Financial Highlights","excerpt":"Complaints Upheld | 48% | 41% | +7pp"}},{"url":"Complaints_Root_Cause_Analysis_FY2024.md","location":{"section":"Summary","excerpt":"342 complaints received during FY2024 (April 2023 – March 2024), of which 164 (48%) were upheld"}}]},{"id":"fsc-kpi-2c","type":"shape","shapeType":"rounded-rect","x":6.94,"y":1.5,"w":2.88,"h":1.8,"fill":{"type":"solid","color":"fffff0"},"stroke":{"width":1,"color":"fefcbf","style":"solid"},"textRuns":[{"text":"94.6%\\n","fontSize":28,"bold":true,"color":"975a16"},{"text":"Client Retention\\n(Target: 95%)","fontSize":11,"color":"975a16"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Annual_Report_FY2024.md","location":{"section":"Chairman\'s Statement","excerpt":"Client retention remained strong at 94.6%, though marginally below our 95% target"}}]},{"id":"fsc-kpi-2d","type":"shape","shapeType":"rounded-rect","x":10.16,"y":1.5,"w":2.67,"h":1.8,"fill":{"type":"solid","color":"f0fff4"},"stroke":{"width":1,"color":"c6f6d5","style":"solid"},"textRuns":[{"text":"£12.8B\\n","fontSize":28,"bold":true,"color":"276749"},{"text":"Assets Under\\nManagement","fontSize":11,"color":"276749"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Annual_Report_FY2024.md","location":{"section":"Chairman\'s Statement","excerpt":"Our assets under management grew 9.2% to £12.8 billion (FY2023: £11.7 billion)"}}]},{"id":"fsc-body-2a","type":"shape","x":0.5,"y":3.6,"w":6,"h":3.5,"textRuns":[{"text":"Areas of Concern\\n\\n","fontSize":16,"bold":true,"color":"c53030"},{"text":"• Complaints root cause: suitability in retirement advice (37% of upheld) and fee disclosure issues (28%)\\n• Mass affluent retention dropped to 92.8%\\n• Granular outcome monitoring by segment not yet operational\\n• Vulnerability indicators not systematically recorded\\n• Adviser attrition at 11.2% (above 10% target)","fontSize":11,"color":"4a5568"}],"style":{"align":"left","valign":"top"},"sources":[{"url":"Complaints_Root_Cause_Analysis_FY2024.md","location":{"section":"Root Cause Analysis — Upheld Complaints","excerpt":"Retirement advice suitability | 61 | 37% | Products & Services"}},{"url":"Annual_Report_FY2024.md","location":{"section":"Chairman\'s Statement","excerpt":"particularly among our mass affluent segment where retention declined to 92.8%"}},{"url":"CCO_Interview_Jan2025.md","location":{"section":"Interview Transcript","excerpt":"our identification rate of 2.9% is embarrassingly low"}}]},{"id":"fsc-body-2b","type":"shape","x":6.9,"y":3.6,"w":5.93,"h":3.5,"textRuns":[{"text":"Implementation Progress\\n\\n","fontSize":16,"bold":true,"color":"276749"},{"text":"• Open products implementation met 31 July 2023 deadline\\n• Closed book review completed by 31 July 2024\\n• Consumer Duty Steering Committee meets monthly\\n• Consumer Duty Champion (NED) appointed\\n• £1.8M additional investment approved for FY2025\\n• Technology upgrades to MI platform in progress","fontSize":11,"color":"4a5568"}],"style":{"align":"left","valign":"top"},"sources":[{"url":"Consumer_Duty_Implementation_Plan.md","location":{"section":"Executive Summary","excerpt":"initial implementation was completed by the regulatory deadlines of 31 July 2023 (open products) and 31 July 2024 (closed products)"}},{"url":"Annual_Report_FY2024.md","location":{"section":"Chief Executive\'s Review","excerpt":"The Board has approved additional investment of £1.8 million in FY2025 to strengthen our Consumer Duty infrastructure"}},{"url":"Consumer_Duty_Steering_Committee_Minutes_Nov2024.md","location":{"section":"CRM 2.0 Project Update","excerpt":"Phase 2 (MI dashboards + automated reporting) targeting Q2 2025"}}]},{"id":"fsc-logo-1","type":"shape","shapeType":"rectangle","x":6.17,"y":7,"w":1,"h":0.35,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/ashworth-reid-advisory.svg","sizing":"contain"}}]},{"label":"Fair Value Assessment","elements":[{"id":"fsc-header-3","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"Fair Value Assessment — Key Findings by Division","fontSize":28,"bold":true,"color":"7b2d3b"}],"style":{"align":"left","valign":"bottom"}},{"id":"fsc-line-3","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"e2e8f0"}},{"id":"fsc-gold-2","type":"line","x":0.5,"y":1.25,"w":3,"h":0,"style":{"borderWidth":1.5,"borderColor":"c9a84c"}},{"id":"fsc-table-3","type":"table","x":0.5,"y":1.5,"w":12.33,"h":2.8,"tableData":{"rows":[{"cells":[{"text":"Division","textRuns":[{"text":"Division","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"AUM","textRuns":[{"text":"AUM","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"% of Total","textRuns":[{"text":"% of Total","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Fair Value RAG","textRuns":[{"text":"Fair Value RAG","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Key Risk","textRuns":[{"text":"Key Risk","bold":true,"fontSize":11,"color":"ffffff"}]}]},{"cells":[{"text":"Discretionary (DPM)","textRuns":[{"text":"Discretionary (DPM)","fontSize":11}]},{"text":"£7.9B","textRuns":[{"text":"£7.9B","fontSize":11}]},{"text":"62%","textRuns":[{"text":"62%","fontSize":11}]},{"text":"Amber","textRuns":[{"text":"Amber","fontSize":11,"color":"d69e2e","bold":true}]},{"text":"Fee layering not fully transparent","textRuns":[{"text":"Fee layering not fully transparent","fontSize":10}]}]},{"cells":[{"text":"Advisory","textRuns":[{"text":"Advisory","fontSize":11}]},{"text":"£2.9B","textRuns":[{"text":"£2.9B","fontSize":11}]},{"text":"23%","textRuns":[{"text":"23%","fontSize":11}]},{"text":"Amber","textRuns":[{"text":"Amber","fontSize":11,"color":"d69e2e","bold":true}]},{"text":"Retirement advice suitability gaps","textRuns":[{"text":"Retirement advice suitability gaps","fontSize":10}]}]},{"cells":[{"text":"Platform Services","textRuns":[{"text":"Platform Services","fontSize":11}]},{"text":"£2.0B","textRuns":[{"text":"£2.0B","fontSize":11}]},{"text":"15%","textRuns":[{"text":"15%","fontSize":11}]},{"text":"Green","textRuns":[{"text":"Green","fontSize":11,"color":"276749","bold":true}]},{"text":"Limited exposure (execution-only)","textRuns":[{"text":"Limited exposure (execution-only)","fontSize":10}]}]}],"headerRow":true,"headerStyle":{"backgroundColor":"3d1520"}},"sources":[{"url":"Fair_Value_Assessment_DPM_2024.md","location":{"section":"Product Description","excerpt":"£7.9 billion across approximately 8,400 client accounts"}},{"url":"Fair_Value_Assessment_Platform_Services_2024.md","location":{"section":"Product Description","excerpt":"£2.0 billion across approximately 4,800 client accounts"}},{"url":"Annual_Report_FY2024.md","location":{"section":"Chief Executive\'s Review","excerpt":"Discretionary Portfolio Management division, which represents 62% of AUM at £7.9 billion"}}]},{"id":"fsc-finding-3a","type":"shape","x":0.5,"y":4.6,"w":6,"h":2.5,"textRuns":[{"text":"DPM Fee Structure Concern\\n\\n","fontSize":14,"bold":true,"color":"7b2d3b"},{"text":"The DPM division\'s fee layering (management fee + platform fee + underlying fund charges) totals 1.82% for the average client portfolio. This compares unfavourably to peers at 1.45–1.60%. The FCA\'s fair value framework requires demonstrable evidence that higher costs deliver proportionally better outcomes.\\n\\n","fontSize":11,"color":"4a5568"},{"text":"Balanced Portfolio returned 8.7% net vs 7.9% benchmark — outperformance may not fully justify the fee premium.","fontSize":11,"italic":true,"color":"975a16"}],"style":{"align":"left","valign":"top"},"sources":[{"url":"Fair_Value_Assessment_DPM_2024.md","location":{"section":"Peer Comparison","excerpt":"Hargreave Ellison\'s DPM fees are marginally above the mid-tier peer group median"}},{"url":"Annual_Report_FY2024.md","location":{"section":"Chief Executive\'s Review","excerpt":"core Balanced Portfolio returning 8.7% net of fees against a benchmark return of 7.9%"}}]},{"id":"fsc-finding-3b","type":"shape","x":6.9,"y":4.6,"w":5.93,"h":2.5,"textRuns":[{"text":"Vulnerable Customer Policy Gaps\\n\\n","fontSize":14,"bold":true,"color":"7b2d3b"},{"text":"Current vulnerability recording is ad-hoc and inconsistent. The Vulnerable Customer Policy v2 exists but is not embedded in adviser workflows or CRM systems. No automated flags for potential vulnerability indicators.\\n\\n","fontSize":11,"color":"4a5568"},{"text":"\\"We have the policy on paper, but I\'m not confident every adviser is applying it consistently. The systems don\'t support it.\\"\\n— CCO Interview, Jan 2025","fontSize":11,"italic":true,"color":"718096"}],"style":{"align":"left","valign":"top"},"sources":[{"url":"Vulnerable_Customer_Policy_v2.md","location":{"section":"Current System Limitations","excerpt":"The current CRM system (Salesforce, implemented 2019) supports a basic vulnerability flag (Yes/No) and a free-text notes field"}},{"url":"CCO_Interview_Jan2025.md","location":{"section":"Interview Transcript","excerpt":"the CRM makes it clunky to record — it\'s a free-text field, there\'s no structured way to capture the vulnerability driver"}}]},{"id":"fsc-logo-2","type":"shape","shapeType":"rectangle","x":6.17,"y":7,"w":1,"h":0.35,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/ashworth-reid-advisory.svg","sizing":"contain"}}]},{"label":"Outcome Monitoring Gaps","elements":[{"id":"fsc-header-4","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"Outcome Monitoring — Maturity Assessment","fontSize":28,"bold":true,"color":"7b2d3b"}],"style":{"align":"left","valign":"bottom"}},{"id":"fsc-line-4","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"e2e8f0"}},{"id":"fsc-gold-3","type":"line","x":0.5,"y":1.25,"w":3,"h":0,"style":{"borderWidth":1.5,"borderColor":"c9a84c"}},{"id":"fsc-table-4","type":"table","x":0.5,"y":1.5,"w":12.33,"h":3.5,"tableData":{"rows":[{"cells":[{"text":"Consumer Duty Outcome","textRuns":[{"text":"Consumer Duty Outcome","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Current Maturity","textRuns":[{"text":"Current Maturity","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Key Gap","textRuns":[{"text":"Key Gap","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Risk Level","textRuns":[{"text":"Risk Level","bold":true,"fontSize":11,"color":"ffffff"}]}]},{"cells":[{"text":"Products & Services","textRuns":[{"text":"Products & Services","fontSize":11}]},{"text":"Developing","textRuns":[{"text":"Developing","fontSize":11}]},{"text":"No target market review for closed book","textRuns":[{"text":"No target market review for closed book","fontSize":10}]},{"text":"Medium","textRuns":[{"text":"Medium","fontSize":11,"color":"d69e2e","bold":true}]}]},{"cells":[{"text":"Price & Value","textRuns":[{"text":"Price & Value","fontSize":11}]},{"text":"Basic","textRuns":[{"text":"Basic","fontSize":11}]},{"text":"Fee benchmarking incomplete for DPM","textRuns":[{"text":"Fee benchmarking incomplete for DPM","fontSize":10}]},{"text":"High","textRuns":[{"text":"High","fontSize":11,"color":"c53030","bold":true}]}]},{"cells":[{"text":"Consumer Understanding","textRuns":[{"text":"Consumer Understanding","fontSize":11}]},{"text":"Developing","textRuns":[{"text":"Developing","fontSize":11}]},{"text":"Client comms not tested for comprehension","textRuns":[{"text":"Client comms not tested for comprehension","fontSize":10}]},{"text":"Medium","textRuns":[{"text":"Medium","fontSize":11,"color":"d69e2e","bold":true}]}]},{"cells":[{"text":"Consumer Support","textRuns":[{"text":"Consumer Support","fontSize":11}]},{"text":"Basic","textRuns":[{"text":"Basic","fontSize":11}]},{"text":"Vulnerability recording inconsistent","textRuns":[{"text":"Vulnerability recording inconsistent","fontSize":10}]},{"text":"High","textRuns":[{"text":"High","fontSize":11,"color":"c53030","bold":true}]}]},{"cells":[{"text":"Cross-Cutting: Governance","textRuns":[{"text":"Cross-Cutting: Governance","fontSize":11}]},{"text":"Established","textRuns":[{"text":"Established","fontSize":11}]},{"text":"SMCR mapping needs refresh","textRuns":[{"text":"SMCR mapping needs refresh","fontSize":10}]},{"text":"Low","textRuns":[{"text":"Low","fontSize":11,"color":"276749","bold":true}]}]}],"headerRow":true,"headerStyle":{"backgroundColor":"3d1520"}},"sources":[{"url":"Consumer_Duty_Implementation_Plan.md","location":{"section":"Price & Value Outcome","excerpt":"Fair value assessment methodology does not yet systematically incorporate client outcome data"}},{"url":"Compliance_Monitoring_Programme_FY2025.md","location":{"section":"Thematic Reviews","excerpt":"The programme is approximately 40% behind plan due to resource constraints"}},{"url":"SMCR_Accountability_Map.md","location":{"section":"Gaps and Observations","excerpt":"the assessment framework has not been updated to reflect this"}}]},{"id":"fsc-callout-4","type":"shape","shapeType":"rounded-rect","x":0.5,"y":5.3,"w":12.33,"h":1.7,"fill":{"type":"solid","color":"fff5f5"},"textRuns":[{"text":"Priority Finding: ","fontSize":12,"bold":true,"color":"c53030"},{"text":"The firm lacks granular outcome monitoring by client segment. The FCA expects firms to demonstrate differential outcomes analysis — particularly between HNW (£3.05M avg portfolio) and Mass Affluent (£338K avg) segments, where fee impact is proportionally different. Current MI systems cannot produce this segmentation without significant manual intervention.","fontSize":11,"color":"742a2a"}],"style":{"align":"left","valign":"middle","padding":12},"sources":[{"url":"Annual_Report_FY2024.md","location":{"section":"Client Segmentation","excerpt":"High Net Worth (>£1M) | 2,100 | £6.4B | £3.05M"}},{"url":"Adviser_Focus_Group_Notes_Jan2025.md","location":{"section":"Focus Group Discussion","excerpt":"My average client has maybe £180,000 with us. They\'re paying £1,500 to £2,000 a year in total costs."}},{"url":"Head_of_Technology_Interview_Jan2025.md","location":{"section":"Interview Transcript","excerpt":"There\'s no single client view. If I want to know everything about a client — their portfolio, their complaint history, their vulnerability status"}}]},{"id":"fsc-logo-3","type":"shape","shapeType":"rectangle","x":6.17,"y":7,"w":1,"h":0.35,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/ashworth-reid-advisory.svg","sizing":"contain"}}]},{"label":"Remediation Roadmap","elements":[{"id":"fsc-header-5","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"Recommended Remediation Roadmap","fontSize":28,"bold":true,"color":"7b2d3b"}],"style":{"align":"left","valign":"bottom"}},{"id":"fsc-line-5","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"e2e8f0"}},{"id":"fsc-gold-4","type":"line","x":0.5,"y":1.25,"w":3,"h":0,"style":{"borderWidth":1.5,"borderColor":"c9a84c"}},{"id":"fsc-rec-5a","type":"shape","shapeType":"rounded-rect","x":0.5,"y":1.5,"w":5.9,"h":2.5,"fill":{"type":"solid","color":"fff5f5"},"stroke":{"width":1,"color":"fed7d7","style":"solid"},"textRuns":[{"text":"Immediate (0–3 months)\\n\\n","fontSize":14,"bold":true,"color":"c53030"},{"text":"• Commission independent fee benchmarking for DPM\\n• Implement vulnerability recording in CRM\\n• Establish segment-level MI dashboards\\n• Review and update all client-facing fee disclosures\\n• Refresh SMCR accountability mapping","fontSize":11,"color":"4a5568"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Consumer_Duty_Implementation_Plan.md","location":{"section":"Known Data Gaps","excerpt":"The Firm cannot currently produce granular outcome data broken down by client segment"}},{"url":"Vulnerable_Customer_Policy_v2.md","location":{"section":"Current System Limitations","excerpt":"It does not support: - Multiple concurrent vulnerability drivers - Severity or urgency classification"}},{"url":"SMCR_Accountability_Map.md","location":{"section":"Gaps and Observations","excerpt":"Dual-hatting of CCO: Graham Saunders holds both SMF16 (Compliance Oversight) and SMF17 (MLRO)"}}]},{"id":"fsc-rec-5b","type":"shape","shapeType":"rounded-rect","x":6.9,"y":1.5,"w":5.93,"h":2.5,"fill":{"type":"solid","color":"fffff0"},"stroke":{"width":1,"color":"fefcbf","style":"solid"},"textRuns":[{"text":"Medium-Term (3–9 months)\\n\\n","fontSize":14,"bold":true,"color":"975a16"},{"text":"• Deploy automated outcome monitoring platform\\n• Conduct suitability review of retirement advice book\\n• Implement client communication testing framework\\n• Develop closed book product lifecycle reviews\\n• Train all 128 advisers on enhanced vulnerability protocol","fontSize":11,"color":"4a5568"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Complaints_Root_Cause_Analysis_FY2024.md","location":{"section":"Recommendations","excerpt":"Implement a mandatory pre-drawdown suitability checklist and require senior adviser sign-off"}},{"url":"COO_Interview_Jan2025.md","location":{"section":"Interview Transcript","excerpt":"Consumer Duty is supposed to change how firms think about clients"}},{"url":"IT_Budget_FY2025.md","location":{"section":"MI & Reporting","excerpt":"Significant increase reflects Consumer Duty MI requirements"}}]},{"id":"fsc-rec-5c","type":"shape","shapeType":"rounded-rect","x":0.5,"y":4.3,"w":12.33,"h":2.7,"fill":{"type":"solid","color":"f7fafc"},"stroke":{"width":1,"color":"e2e8f0","style":"solid"},"textRuns":[{"text":"Investment Summary\\n\\n","fontSize":14,"bold":true,"color":"7b2d3b"},{"text":"Board-approved budget of £1.8M for FY2025 covers MI platform enhancements, additional compliance resource (2 FTE), and technology upgrades. Our assessment suggests this is adequate for immediate priorities but may require supplementation of £400–600K for the automated outcome monitoring platform and suitability review programme.\\n\\nTotal estimated compliance investment: £2.2–2.4M over 12 months. This represents approximately 2% of adjusted operating profit — a proportionate investment given the regulatory risk profile and potential FCA enforcement exposure.","fontSize":11,"color":"4a5568"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Annual_Report_FY2024.md","location":{"section":"Financial Highlights","excerpt":"Adjusted Operating Profit | £28.3M | £26.9M | +5.1%"}},{"url":"IT_Budget_FY2025.md","location":{"section":"CRM 2.0 Project","excerpt":"Phase 3 (advanced outcome tracking) is expected to require an additional £250-350K in FY2026"}},{"url":"Board_Paper_Q3_Risk_Register.md","location":{"section":"Conduct Risk","excerpt":"control weaknesses are crystallising into actual client harm"}},{"url":"Client_Satisfaction_Survey_2024.md","location":{"section":"Value for Money","excerpt":"Value for money is the weakest dimension across all segments"}}]},{"id":"fsc-logo-4","type":"shape","shapeType":"rectangle","x":6.17,"y":7,"w":1,"h":0.35,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/ashworth-reid-advisory.svg","sizing":"contain"}}]}]')},500529,(e,t,o)=>{t.exports=JSON.parse('[{"label":"Title Slide","elements":[{"id":"hdt-bg-1","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":13.33,"h":7.5,"fill":{"type":"solid","color":"2c5282"}},{"id":"hdt-accent-1","type":"line","x":0.8,"y":1.8,"w":3,"h":0,"style":{"borderWidth":3,"borderColor":"63b3ed"}},{"id":"hdt-title-1","type":"shape","x":0.8,"y":2,"w":11.73,"h":2.5,"textRuns":[{"text":"Digital Transformation\\nReadiness Assessment","fontSize":36,"bold":true,"color":"ffffff"}],"style":{"align":"left","valign":"top"}},{"id":"hdt-subtitle-1","type":"shape","x":0.8,"y":4.8,"w":11.73,"h":0.6,"textRuns":[{"text":"Forward Together 2025–2030 — Independent Review","fontSize":16,"color":"a0aec0"}],"style":{"align":"left"}},{"id":"hdt-footer-1","type":"shape","x":0.8,"y":6,"w":11.73,"h":0.8,"textRuns":[{"text":"Prepared for Meridian Health Group NHS Foundation Trust\\nby Castlebridge Advisory LLP  |  March 2025","fontSize":13,"color":"718096"}],"style":{"align":"left"}},{"id":"hdt-logo-0","type":"shape","shapeType":"rectangle","x":0.5,"y":0.5,"w":2.5,"h":1.0,"fill":{"type":"image","src":"/demo-logos/castlebridge-advisory.svg","sizing":"contain"}}]},{"label":"Digital Maturity Baseline","elements":[{"id":"hdt-headerbar-1","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":13.33,"h":1.15,"fill":{"type":"solid","color":"2c5282"}},{"id":"hdt-header-2","type":"shape","x":0.5,"y":0.15,"w":12.33,"h":0.8,"textRuns":[{"text":"Digital Maturity — Current Baseline","fontSize":28,"bold":true,"color":"ffffff"}],"style":{"align":"left","valign":"bottom"}},{"id":"hdt-kpi-2a","type":"shape","shapeType":"rounded-rect","x":0.5,"y":1.5,"w":3.8,"h":1.8,"fill":{"type":"solid","color":"fff5f5"},"stroke":{"width":1,"color":"fed7d7","style":"solid"},"textRuns":[{"text":"Stage 2\\n","fontSize":28,"bold":true,"color":"c53030"},{"text":"HIMSS EMRAM\\n","fontSize":12,"color":"c53030"},{"text":"(national median: Stage 3)","fontSize":10,"color":"fc8181"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Annual_Report_2023-2024.md","location":{"section":"Digital Maturity","excerpt":"Meridian was assessed at HIMSS EMRAM Stage 2 in the 2023 assessment cycle, against a national median of Stage 3"}},{"url":"NHS_Digital_Maturity_Benchmarking_2024.md","location":{"section":"HIMSS EMRAM Comparison","excerpt":"Meridian sits in the bottom quintile nationally."}}]},{"id":"hdt-kpi-2b","type":"shape","shapeType":"rounded-rect","x":4.76,"y":1.5,"w":3.8,"h":1.8,"fill":{"type":"solid","color":"fffff0"},"stroke":{"width":1,"color":"fefcbf","style":"solid"},"textRuns":[{"text":"2.7%\\n","fontSize":28,"bold":true,"color":"975a16"},{"text":"IT Spend as %\\nof Revenue\\n","fontSize":12,"color":"975a16"},{"text":"(NHS benchmark: 3.5%)","fontSize":10,"color":"d69e2e"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Annual_Report_2023-2024.md","location":{"section":"Financial Performance","excerpt":"IT expenditure for 2023/24 was £12.3M, representing 2.7% of total revenue"}}]},{"id":"hdt-kpi-2c","type":"shape","shapeType":"rounded-rect","x":9.03,"y":1.5,"w":3.8,"h":1.8,"fill":{"type":"solid","color":"fff5f5"},"stroke":{"width":1,"color":"fed7d7","style":"solid"},"textRuns":[{"text":"23%\\n","fontSize":28,"bold":true,"color":"c53030"},{"text":"Patient Portal\\nRegistration\\n","fontSize":12,"color":"c53030"},{"text":"(target: 50%)","fontSize":10,"color":"fc8181"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Annual_Report_2023-2024.md","location":{"section":"Digital Maturity","excerpt":"Patient portal (MyMeridian) has 23% registration rate against a target of 50%"}},{"url":"Patient_Experience_Survey_2024.md","location":{"section":"Patient Portal (MyMeridian)","excerpt":"23% of respondents were registered on MyMeridian (consistent with portal registration data)"}}]},{"id":"hdt-body-2","type":"shape","x":0.5,"y":3.6,"w":6,"h":3.5,"textRuns":[{"text":"Systems Landscape\\n\\n","fontSize":16,"bold":true,"color":"2c5282"},{"text":"• No single integrated EHR — MedBase v4.2 on 5 of 8 sites, legacy Carenotes on 3 sites\\n• Paper-based prescribing on 4 of 8 sites\\n• Basic telehealth deployed during COVID but not scaled\\n• Cybersecurity: \'approaching standards\' on NHS DSPT\\n• 142 discrete clinical and operational systems identified\\n• 67% of systems older than 5 years","fontSize":11,"color":"4a5568"}],"style":{"align":"left","valign":"top"},"sources":[{"url":"Systems_Inventory_2024.md","location":{"section":"Clinical Systems","excerpt":"MedBase EHR | MedBase Systems Ltd | 4.2.7 | RI, AGH, SCH, RMU, MCH"}},{"url":"Annual_Report_2023-2024.md","location":{"section":"Digital Maturity","excerpt":"No single integrated EHR — MedBase v4.2 covers 5 sites, with 3 sites on legacy Carenotes system"}},{"url":"Cybersecurity_Assessment_DSPT_2024.md","location":{"section":"Assessment Overview","excerpt":"resulting in an overall status of \\"Approaching Standards\\" — below the \\"Standards Met\\" threshold of 95%"}}]},{"id":"hdt-body-2b","type":"shape","x":6.9,"y":3.6,"w":5.93,"h":3.5,"textRuns":[{"text":"Operational Context\\n\\n","fontSize":16,"bold":true,"color":"2c5282"},{"text":"• 1.2M patients served across 8 sites\\n• 3,200 WTE staff (290 IT/corporate)\\n• 18-week RTT at 68.4% (target 92%)\\n• 42,300 patients on waiting list\\n• Revenue: £450.2M (4.3% growth)\\n• IT spend: £12.3M (peer avg: 3.1%)\\n\\n","fontSize":11,"color":"4a5568"},{"text":"\\"Our digital infrastructure is holding back clinical innovation. We can\'t keep asking clinicians to work around systems that don\'t talk to each other.\\"\\n— CIO Interview, Jan 2025","fontSize":11,"italic":true,"color":"718096"}],"style":{"align":"left","valign":"top"},"sources":[{"url":"Annual_Report_2023-2024.md","location":{"section":"Performance Summary","excerpt":"the 1.2 million people we serve across the East Midlands"}},{"url":"CIO_Interview_Jan2025.md","location":{"section":"Stakeholder Interview: Neil Granville, Chief Information Officer","excerpt":"They don\'t talk to each other meaningfully. If a patient presents at Royal Infirmary but their records are on Carenotes at Parklands, the clinician essentially has no visibility."}}]},{"id":"hdt-logo-1","type":"shape","shapeType":"rectangle","x":0.3,"y":0.2,"w":0.8,"h":0.35,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/castlebridge-advisory.svg","sizing":"contain"}}]},{"label":"Clinical Impact Assessment","elements":[{"id":"hdt-headerbar-2","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":13.33,"h":1.15,"fill":{"type":"solid","color":"2c5282"}},{"id":"hdt-header-3","type":"shape","x":0.5,"y":0.15,"w":12.33,"h":0.8,"textRuns":[{"text":"Clinical Performance — Digital Dependencies","fontSize":28,"bold":true,"color":"ffffff"}],"style":{"align":"left","valign":"bottom"}},{"id":"hdt-table-3","type":"table","x":0.5,"y":1.5,"w":12.33,"h":3,"tableData":{"rows":[{"cells":[{"text":"Clinical Target","textRuns":[{"text":"Clinical Target","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Performance","textRuns":[{"text":"Performance","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"National Target","textRuns":[{"text":"National Target","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Digital Enabler Required","textRuns":[{"text":"Digital Enabler Required","bold":true,"fontSize":11,"color":"ffffff"}]}]},{"cells":[{"text":"A&E 4-hour standard","textRuns":[{"text":"A&E 4-hour standard","fontSize":11}]},{"text":"71.8%","textRuns":[{"text":"71.8%","fontSize":11,"color":"c53030","bold":true}]},{"text":"76.0%","textRuns":[{"text":"76.0%","fontSize":11}]},{"text":"Real-time bed management, patient flow","textRuns":[{"text":"Real-time bed management, patient flow","fontSize":10}]}]},{"cells":[{"text":"18-week RTT","textRuns":[{"text":"18-week RTT","fontSize":11}]},{"text":"68.4%","textRuns":[{"text":"68.4%","fontSize":11,"color":"c53030","bold":true}]},{"text":"92.0%","textRuns":[{"text":"92.0%","fontSize":11}]},{"text":"Integrated scheduling, e-referrals","textRuns":[{"text":"Integrated scheduling, e-referrals","fontSize":10}]}]},{"cells":[{"text":"Cancer 62-day","textRuns":[{"text":"Cancer 62-day","fontSize":11}]},{"text":"72.1%","textRuns":[{"text":"72.1%","fontSize":11,"color":"c53030","bold":true}]},{"text":"85.0%","textRuns":[{"text":"85.0%","fontSize":11}]},{"text":"Pathway tracking, diagnostic ordering","textRuns":[{"text":"Pathway tracking, diagnostic ordering","fontSize":10}]}]},{"cells":[{"text":"Patient FFT positive","textRuns":[{"text":"Patient FFT positive","fontSize":11}]},{"text":"87.2%","textRuns":[{"text":"87.2%","fontSize":11,"color":"d69e2e","bold":true}]},{"text":"90.0%","textRuns":[{"text":"90.0%","fontSize":11}]},{"text":"Patient portal, digital communications","textRuns":[{"text":"Patient portal, digital communications","fontSize":10}]}]},{"cells":[{"text":"Staff sickness absence","textRuns":[{"text":"Staff sickness absence","fontSize":11}]},{"text":"5.8%","textRuns":[{"text":"5.8%","fontSize":11,"color":"d69e2e","bold":true}]},{"text":"<=5.0%","textRuns":[{"text":"<=5.0%","fontSize":11}]},{"text":"Workforce rostering, digital tools","textRuns":[{"text":"Workforce rostering, digital tools","fontSize":10}]}]}],"headerRow":true,"headerStyle":{"backgroundColor":"2c5282"}},"sources":[{"url":"Annual_Report_2023-2024.md","location":{"section":"Clinical Performance","excerpt":"A&E 4-hour standard | 71.8% | 76.0% | Red"}},{"url":"Digital_Strategy_2025-2030.md","location":{"section":"Strategic Pillars","excerpt":"Deploy electronic prescribing, observations, and clinical decision support Trust-wide"}}]},{"id":"hdt-callout-3","type":"shape","shapeType":"rounded-rect","x":0.5,"y":4.8,"w":12.33,"h":2.2,"fill":{"type":"solid","color":"ebf8ff"},"textRuns":[{"text":"EHR Consolidation — Critical Path Decision\\n\\n","fontSize":13,"bold":true,"color":"2b6cb0"},{"text":"The dual-EHR environment (MedBase + Carenotes) is the single largest barrier to clinical integration. Consolidation to a single platform is essential but represents a 24-36 month programme at estimated cost of £8-12M. Vendor demo debriefs in January 2025 identified three viable options. The CIO recommends a phased approach starting with the three Carenotes sites, targeting HIMSS EMRAM Stage 4 by 2028.\\n\\nStakeholder concern: The Medical Director emphasised that any EHR migration must not compromise patient safety or add clinical burden during transition.","fontSize":11,"color":"2c5282"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"CIO_Interview_Jan2025.md","location":{"section":"Stakeholder Interview: Neil Granville, Chief Information Officer","excerpt":"The biggest single problem is that we\'re running two completely separate clinical records systems across eight sites."}},{"url":"EHR_Vendor_Demo_Debrief_Jan2025.md","location":{"section":"Overview","excerpt":"Three vendors were invited to present 3-hour demonstrations to a clinical and technical audience"}},{"url":"Medical_Director_Interview_Jan2025.md","location":{"section":"Stakeholder Interview: Dr Rajesh Kapoor, Medical Director","excerpt":"If we go for a Tier 1 system, we need significant clinical leadership in the implementation."}}]},{"id":"hdt-logo-2","type":"shape","shapeType":"rectangle","x":0.3,"y":0.2,"w":0.8,"h":0.35,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/castlebridge-advisory.svg","sizing":"contain"}}]},{"label":"Workforce & Change Readiness","elements":[{"id":"hdt-headerbar-3","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":13.33,"h":1.15,"fill":{"type":"solid","color":"2c5282"}},{"id":"hdt-header-4","type":"shape","x":0.5,"y":0.15,"w":12.33,"h":0.8,"textRuns":[{"text":"Workforce Digital Readiness & Stakeholder Views","fontSize":28,"bold":true,"color":"ffffff"}],"style":{"align":"left","valign":"bottom"}},{"id":"hdt-body-4a","type":"shape","x":0.5,"y":1.5,"w":6,"h":3,"textRuns":[{"text":"Digital Skills Assessment\\n\\n","fontSize":16,"bold":true,"color":"2c5282"},{"text":"Workforce survey (n=1,842) revealed significant digital confidence gaps:\\n\\n• 34% of clinical staff report low confidence with current digital tools\\n• Only 28% of nursing staff completed digital skills training in past 12 months\\n• IT department capacity: 290 staff for 142 systems across 8 sites\\n• Key gap: No dedicated clinical informatics team\\n• Training budget: £180K (£55 per WTE, vs NHS benchmark £120)","fontSize":11,"color":"4a5568"}],"style":{"align":"left","valign":"top"},"sources":[{"url":"Workforce_Digital_Skills_Survey_2024.md","location":{"section":"Executive Summary","excerpt":"41% of clinical staff rated themselves \\"not confident\\" using digital clinical systems"}},{"url":"Org_Chart_IT_Department_2024.md","location":{"section":"Department Overview","excerpt":"Establishment: 104 WTE\\n- In-post: 87 WTE (84% fill rate)"}}]},{"id":"hdt-body-4b","type":"shape","x":6.9,"y":1.5,"w":5.93,"h":3,"textRuns":[{"text":"Stakeholder Perspectives\\n\\n","fontSize":16,"bold":true,"color":"2c5282"},{"text":"\\"Every time a patient moves between our sites, their notes have to be printed, faxed, or re-entered. It\'s 2025.\\"\\n— Chief Nursing Officer\\n\\n\\"We piloted telehealth during COVID and patients loved it. But we never invested in making it permanent.\\"\\n— Clinical Director, Cardiology\\n\\n\\"The CFO is supportive but realistic — we need to show digital investment reduces costs, not just improves quality.\\"\\n— CIO Interview","fontSize":11,"italic":true,"color":"718096"}],"style":{"align":"left","valign":"top"},"sources":[{"url":"Chief_Nursing_Officer_Interview_Jan2025.md","location":{"section":"Stakeholder Interview: Helen Blackwood, Chief Nursing Officer","excerpt":"Nursing is drowning in documentation, and the systems make it worse, not better."}},{"url":"Clinical_Director_Cardiology_Interview_Jan2025.md","location":{"section":"Stakeholder Interview: Dr Ben Morris, Clinical Director — Cardiology","excerpt":"I trained at the Mayo Clinic for a fellowship year, where they were using Epic. Coming back to MedBase was like travelling back in time 15 years."}},{"url":"CIO_Interview_Jan2025.md","location":{"section":"Stakeholder Interview: Neil Granville, Chief Information Officer","excerpt":"We peaked at 28% during COVID when we had no choice. We\'re now at 8%."}}]},{"id":"hdt-callout-4","type":"shape","shapeType":"rounded-rect","x":0.5,"y":4.8,"w":12.33,"h":2.2,"fill":{"type":"solid","color":"f0fff4"},"textRuns":[{"text":"Telehealth Opportunity\\n\\n","fontSize":13,"bold":true,"color":"276749"},{"text":"Q3 2024 telehealth usage data shows 2,847 virtual consultations across 4 specialties, with patient satisfaction at 91% — higher than in-person (87.2%). However, utilisation varies dramatically: Cardiology (42% of eligible appointments) vs Orthopaedics (8%). A structured telehealth expansion programme could reduce RTT waiting times by an estimated 12-15% while improving patient access for the Trust\'s rural catchment population.","fontSize":11,"color":"2f855a"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Telehealth_Usage_Report_Q3_2024.md","location":{"section":"Activity Data","excerpt":"Virtual outpatient activity in Q3 2024/25 was 8.3% of total outpatient consultations"}},{"url":"Patient_Experience_Survey_2024.md","location":{"section":"Digital Services Deep Dive","excerpt":"62% of respondents said they would prefer to book appointments online if the system were easier to use"}},{"url":"Digital_Strategy_2025-2030.md","location":{"section":"Pillar 2: Virtual Care at Scale","excerpt":"Deliver 25% of outpatient activity virtually by 2027, and deploy remote monitoring for 5,000+ patients"}}]},{"id":"hdt-logo-3","type":"shape","shapeType":"rectangle","x":0.3,"y":0.2,"w":0.8,"h":0.35,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/castlebridge-advisory.svg","sizing":"contain"}}]},{"label":"Transformation Roadmap","elements":[{"id":"hdt-headerbar-4","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":13.33,"h":1.15,"fill":{"type":"solid","color":"2c5282"}},{"id":"hdt-header-5","type":"shape","x":0.5,"y":0.15,"w":12.33,"h":0.8,"textRuns":[{"text":"Recommended Transformation Roadmap","fontSize":28,"bold":true,"color":"ffffff"}],"style":{"align":"left","valign":"bottom"}},{"id":"hdt-rec-5a","type":"shape","shapeType":"rounded-rect","x":0.5,"y":1.5,"w":3.94,"h":3,"fill":{"type":"solid","color":"fff5f5"},"stroke":{"width":1,"color":"fed7d7","style":"solid"},"textRuns":[{"text":"Year 1: Foundations\\n\\n","fontSize":13,"bold":true,"color":"c53030"},{"text":"• EHR consolidation business case\\n• Migrate 3 Carenotes sites to MedBase\\n• Deploy e-prescribing on remaining 4 sites\\n• Achieve DSPT \'standards met\'\\n• Establish clinical informatics team (4 FTE)\\n• Increase IT spend to 3.1%","fontSize":10,"color":"4a5568"}],"style":{"align":"left","valign":"top","padding":10},"sources":[{"url":"Digital_Strategy_2025-2030.md","location":{"section":"Pillar 1: Unified Clinical Platform","excerpt":"Implement a single, integrated Electronic Health Record across all eight sites by 2028."}},{"url":"Cybersecurity_Assessment_DSPT_2024.md","location":{"section":"Assessment Overview","excerpt":"The Trust must achieve at least \\"Standards Met\\" by the June 2025 submission deadline."}}]},{"id":"hdt-rec-5b","type":"shape","shapeType":"rounded-rect","x":4.69,"y":1.5,"w":3.94,"h":3,"fill":{"type":"solid","color":"fffff0"},"stroke":{"width":1,"color":"fefcbf","style":"solid"},"textRuns":[{"text":"Year 2-3: Integration\\n\\n","fontSize":13,"bold":true,"color":"975a16"},{"text":"• Complete EHR consolidation\\n• Deploy integrated scheduling\\n• Scale telehealth to all specialties\\n• Patient portal to 50% registration\\n• Implement real-time bed management\\n• Digital skills training for all staff","fontSize":10,"color":"4a5568"}],"style":{"align":"left","valign":"top","padding":10},"sources":[{"url":"Digital_Strategy_2025-2030.md","location":{"section":"Pillar 3: Digital Front Door","excerpt":"Achieve 60% patient portal registration by 2027 (from 23% today)"}},{"url":"Forward_Together_Strategy_2025-2030.md","location":{"section":"2. Digital Transformation","excerpt":"Scale telehealth and remote monitoring to 25% of outpatient activity"}}]},{"id":"hdt-rec-5c","type":"shape","shapeType":"rounded-rect","x":8.89,"y":1.5,"w":3.94,"h":3,"fill":{"type":"solid","color":"f0fff4"},"stroke":{"width":1,"color":"c6f6d5","style":"solid"},"textRuns":[{"text":"Year 4-5: Optimisation\\n\\n","fontSize":13,"bold":true,"color":"276749"},{"text":"• Target HIMSS EMRAM Stage 4+\\n• AI-assisted clinical decision support\\n• Population health analytics\\n• Interoperability with ICS partners\\n• Continuous improvement framework\\n• IT spend target: 3.5%","fontSize":10,"color":"4a5568"}],"style":{"align":"left","valign":"top","padding":10},"sources":[{"url":"Digital_Strategy_2025-2030.md","location":{"section":"Pillar 5: Digital Workforce","excerpt":"Ensure 90% of staff are rated \\"confident\\" or \\"very confident\\" in using digital systems by 2028."}},{"url":"NHS_Digital_Maturity_Benchmarking_2024.md","location":{"section":"Key Metrics Comparison","excerpt":"IT spend (% of revenue) | 2.7% | 3.4% | 4.1% (UHL) | 3.5%"}}]},{"id":"hdt-investment-5","type":"shape","shapeType":"rounded-rect","x":0.5,"y":4.8,"w":12.33,"h":2.2,"fill":{"type":"solid","color":"ebf8ff"},"textRuns":[{"text":"Investment Case\\n\\n","fontSize":13,"bold":true,"color":"2b6cb0"},{"text":"Estimated total programme cost: £28-35M over 5 years. Current IT spend of £12.3M (2.7% of revenue) must increase to £15.8M (3.5%) — an incremental £3.5M per annum. EHR consolidation represents the single largest capital item at £8-12M. Funding sources: NHS digital transformation funding (£8-10M applied for), Trust capital programme, and ICS partnership contributions. The CIP programme (£14.2M delivered in FY2024) demonstrates organisational capacity for change delivery.","fontSize":11,"color":"2c5282"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Annual_Report_2023-2024.md","location":{"section":"Financial Performance","excerpt":"Cost Improvement Programme Delivery | £14.2M | £11.8M"}},{"url":"CFO_Interview_Jan2025.md","location":{"section":"Stakeholder Interview: Marcus Webb, Chief Financial Officer","excerpt":"we can\'t fund this from internal capital alone. Our annual capital programme is about £28-30 million"}},{"url":"Steering_Committee_Meeting_Nov2024.md","location":{"section":"Castlebridge Advisory Engagement Update","excerpt":"The engagement commences 13 January 2025 with an 8-week programme concluding with a Board presentation on 12 March 2025."}}]},{"id":"hdt-logo-4","type":"shape","shapeType":"rectangle","x":0.3,"y":0.2,"w":0.8,"h":0.35,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/castlebridge-advisory.svg","sizing":"contain"}}]}]')},391315,(e,t,o)=>{t.exports=JSON.parse('[{"label":"Title — Predictive Maintenance Business Case","elements":[{"id":"pm-bg-1","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":13.33,"h":7.5,"fill":{"type":"solid","color":"2d3748"}},{"id":"pm-accent-1","type":"line","x":0.8,"y":1.8,"w":3,"h":0,"style":{"borderWidth":3,"borderColor":"e55c30"}},{"id":"pm-title-1","type":"shape","x":0.8,"y":2,"w":11.73,"h":2.5,"textRuns":[{"text":"Predictive Maintenance\\nBusiness Case","fontSize":36,"bold":true,"color":"ffffff"}],"style":{"align":"left","valign":"top"}},{"id":"pm-subtitle-1","type":"shape","x":0.8,"y":4.8,"w":11.73,"h":0.6,"textRuns":[{"text":"Reducing Unplanned Downtime Across Four Plants","fontSize":16,"color":"a0aec0"}],"style":{"align":"left"}},{"id":"pm-footer-1","type":"shape","x":0.8,"y":6,"w":11.73,"h":0.8,"textRuns":[{"text":"Prepared for Vantage Precision Engineering Ltd\\nby Whitmore Keane LLP  |  March 2025","fontSize":13,"color":"718096"}],"style":{"align":"left"}},{"id":"pm-logo-0","type":"shape","shapeType":"rectangle","x":10.33,"y":0.5,"w":2.5,"h":1,"fill":{"type":"image","src":"/demo-logos/whitmore-keane-consulting.svg","sizing":"contain"}}]},{"label":"The Cost of Reactive Maintenance","elements":[{"id":"pm-darkbg-2","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":13.33,"h":7.5,"fill":{"type":"solid","color":"1a202c"}},{"id":"pm-header-2","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"The Cost of Reactive Maintenance","fontSize":28,"bold":true,"color":"ffffff"}],"style":{"align":"left","valign":"bottom"}},{"id":"pm-line-2","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"4a5568"}},{"id":"pm-kpi-2a","type":"shape","shapeType":"rounded-rect","x":0.5,"y":1.5,"w":3.78,"h":1.8,"fill":{"type":"solid","color":"2d2020"},"stroke":{"width":1,"color":"4a2020","style":"solid"},"textRuns":[{"text":"£8.2M\\n","fontSize":28,"bold":true,"color":"c53030"},{"text":"Unplanned Downtime Cost\\n","fontSize":12,"color":"c53030"},{"text":"(up from £7.1M)","fontSize":10,"color":"fc8181"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Annual_Report_FY2023-24.md","location":{"section":"Chief Executive\'s Review","excerpt":"Annualised unplanned downtime costs reached £8.2 million in FY2023–24, up from £7.1 million two years ago"}},{"url":"Maintenance_Cost_Analysis_FY2023-24.md","location":{"section":"Unplanned Downtime Cost","excerpt":"The £8.2 million cost of unplanned downtime is calculated as follows"}}]},{"id":"pm-kpi-2b","type":"shape","shapeType":"rounded-rect","x":4.62,"y":1.5,"w":3.78,"h":1.8,"fill":{"type":"solid","color":"2d2020"},"stroke":{"width":1,"color":"4a2020","style":"solid"},"textRuns":[{"text":"72%\\n","fontSize":28,"bold":true,"color":"c53030"},{"text":"Group OEE\\n","fontSize":12,"color":"c53030"},{"text":"(world-class: 85%)","fontSize":10,"color":"fc8181"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"OEE_Performance_Dashboard_H1_FY2024-25.md","location":{"section":"Group OEE Summary","excerpt":"| **Group Average** | **81.0%** | **91.3%** | **97.9%** | **72.0%** |"}},{"url":"Annual_Report_FY2023-24.md","location":{"section":"Chief Executive\'s Review","excerpt":"our four manufacturing plants delivered a group-average Overall Equipment Effectiveness of 72%, against a world-class benchmark of 85% or above"}}]},{"id":"pm-kpi-2c","type":"shape","shapeType":"rounded-rect","x":8.74,"y":1.5,"w":4.09,"h":1.8,"fill":{"type":"solid","color":"2d2020"},"stroke":{"width":1,"color":"4a2020","style":"solid"},"textRuns":[{"text":"91.3%\\n","fontSize":28,"bold":true,"color":"c53030"},{"text":"On-Time Delivery\\n","fontSize":12,"color":"c53030"},{"text":"(target: 98%)","fontSize":10,"color":"fc8181"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Annual_Report_FY2023-24.md","location":{"section":"Chief Executive\'s Review","excerpt":"On-time delivery to customers averaged 91.3% against our group target of 98%"}}]},{"id":"pm-body-2a","type":"shape","x":0.5,"y":3.6,"w":6,"h":3.5,"textRuns":[{"text":"How Downtime Hits the P&L\\n\\n","fontSize":16,"bold":true,"color":"ffffff"},{"text":"The reactive maintenance model creates a cascading cost chain: equipment fails without warning, production stops, overtime is authorised to catch up, freight is expedited to meet customer deadlines, and late delivery penalties are incurred regardless.\\n\\n","fontSize":11,"color":"cbd5e0"},{"text":"The £8.2M breaks down as:\\n• Production losses: £4.8M\\n• Overtime to recover schedule: £1.6M\\n• Expedited freight: £0.9M\\n• Late delivery penalties: £0.9M","fontSize":11,"color":"cbd5e0"}],"style":{"align":"left","valign":"top"},"sources":[{"url":"Maintenance_Cost_Analysis_FY2023-24.md","location":{"section":"Unplanned Downtime Cost","excerpt":"The £8.2 million cost of unplanned downtime is calculated as follows"}},{"url":"Annual_Report_FY2023-24.md","location":{"section":"Chief Executive\'s Review","excerpt":"Annualised unplanned downtime costs reached £8.2 million in FY2023–24, up from £7.1 million two years ago"}}]},{"id":"pm-body-2b","type":"shape","x":6.9,"y":3.6,"w":5.93,"h":3.5,"textRuns":[{"text":"Leadership Perspective\\n\\n","fontSize":16,"bold":true,"color":"ffffff"},{"text":"\\"We fix things when they break. That\'s the mindset, particularly at Coventry and Sunderland. Our unplanned downtime cost us £8.2 million when you add up production losses, overtime to catch up, expedited freight to customers, and the penalties on late deliveries.\\"\\n— COO Interview, Jan 2025\\n\\n","fontSize":11,"italic":true,"color":"a0aec0"},{"text":"\\"We are 3-5 years behind our best competitors on digital manufacturing. Three of our four plants have no machine connectivity at all.\\"\\n— CTO Interview, Jan 2025","fontSize":11,"italic":true,"color":"a0aec0"}],"style":{"align":"left","valign":"top"},"sources":[{"url":"COO_Interview_Jan2025.md","location":{"section":"Interview Transcript","excerpt":"We fix things when they break. That\'s the mindset, particularly at Coventry and Sunderland."}},{"url":"COO_Interview_Jan2025.md","location":{"section":"Interview Transcript","excerpt":"our unplanned downtime cost us £8.2 million when you add up production losses, overtime to catch up, expedited freight to customers, and the penalties on late deliveries"}},{"url":"CTO_Interview_Jan2025.md","location":{"section":"Interview Transcript","excerpt":"three of our four plants have no machine connectivity at all. The data collection is manual."}}]},{"id":"pm-logo-1","type":"shape","shapeType":"rectangle","x":11.83,"y":6.9,"w":1,"h":0.4,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/whitmore-keane-consulting.svg","sizing":"contain"}}]},{"label":"Plant-Level Availability & Downtime Drivers","elements":[{"id":"pm-darkbg-3","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":13.33,"h":7.5,"fill":{"type":"solid","color":"1a202c"}},{"id":"pm-header-3","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"Plant-Level Availability & Downtime Drivers","fontSize":28,"bold":true,"color":"ffffff"}],"style":{"align":"left","valign":"bottom"}},{"id":"pm-line-3","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"4a5568"}},{"id":"pm-table-3","type":"table","x":0.5,"y":1.5,"w":12.33,"h":3,"tableData":{"rows":[{"cells":[{"text":"Plant","textRuns":[{"text":"Plant","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Availability","textRuns":[{"text":"Availability","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Downtime Cost Share","textRuns":[{"text":"Downtime Cost Share","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Primary Driver","textRuns":[{"text":"Primary Driver","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Maintenance Model","textRuns":[{"text":"Maintenance Model","bold":true,"fontSize":11,"color":"ffffff"}]}]},{"cells":[{"text":"Derby","textRuns":[{"text":"Derby","fontSize":11,"bold":true,"color":"cbd5e0"}]},{"text":"88%","textRuns":[{"text":"88%","fontSize":11,"color":"cbd5e0"}]},{"text":"18%","textRuns":[{"text":"18%","fontSize":11,"color":"cbd5e0"}]},{"text":"Cleanroom HVAC","textRuns":[{"text":"Cleanroom HVAC","fontSize":11,"color":"cbd5e0"}]},{"text":"Planned + reactive","textRuns":[{"text":"Planned + reactive","fontSize":11,"color":"d69e2e"}]}]},{"cells":[{"text":"Sheffield","textRuns":[{"text":"Sheffield","fontSize":11,"bold":true,"color":"cbd5e0"}]},{"text":"84%","textRuns":[{"text":"84%","fontSize":11,"color":"cbd5e0"}]},{"text":"22%","textRuns":[{"text":"22%","fontSize":11,"color":"cbd5e0"}]},{"text":"Press brake failures","textRuns":[{"text":"Press brake failures","fontSize":11,"color":"cbd5e0"}]},{"text":"Mostly reactive","textRuns":[{"text":"Mostly reactive","fontSize":11,"color":"d69e2e"}]}]},{"cells":[{"text":"Coventry","textRuns":[{"text":"Coventry","fontSize":11,"bold":true,"color":"cbd5e0"}]},{"text":"78%","textRuns":[{"text":"78%","fontSize":11,"color":"c53030"}]},{"text":"28%","textRuns":[{"text":"28%","fontSize":11,"color":"c53030"}]},{"text":"Ageing CNC fleet","textRuns":[{"text":"Ageing CNC fleet","fontSize":11,"color":"fc8181"}]},{"text":"Fully reactive","textRuns":[{"text":"Fully reactive","fontSize":11,"color":"c53030"}]}]},{"cells":[{"text":"Sunderland","textRuns":[{"text":"Sunderland","fontSize":11,"bold":true,"color":"cbd5e0"}]},{"text":"76%","textRuns":[{"text":"76%","fontSize":11,"color":"c53030"}]},{"text":"32%","textRuns":[{"text":"32%","fontSize":11,"color":"c53030"}]},{"text":"Hydraulic press failures","textRuns":[{"text":"Hydraulic press failures","fontSize":11,"color":"fc8181"}]},{"text":"Fully reactive","textRuns":[{"text":"Fully reactive","fontSize":11,"color":"c53030"}]}]}],"headerRow":true,"headerStyle":{"backgroundColor":"2d3748"}},"sources":[{"url":"OEE_Performance_Dashboard_H1_FY2024-25.md","location":{"section":"Group OEE Summary","excerpt":"| Derby | 88.0% | 91.0% | 97.8% | **78.4%** |"}},{"url":"Maintenance_Cost_Analysis_FY2023-24.md","location":{"section":"Unplanned Downtime Cost","excerpt":"The £8.2 million cost of unplanned downtime is calculated as follows"}},{"url":"COO_Interview_Jan2025.md","location":{"section":"Interview Transcript","excerpt":"We fix things when they break. That\'s the mindset, particularly at Coventry and Sunderland."}}]},{"id":"pm-callout-3","type":"shape","shapeType":"rounded-rect","x":0.5,"y":4.8,"w":12.33,"h":2.2,"fill":{"type":"solid","color":"2d3748"},"stroke":{"width":2,"color":"e55c30","style":"solid"},"textRuns":[{"text":"Priority Sites\\n\\n","fontSize":14,"bold":true,"color":"e55c30"},{"text":"Coventry and Sunderland account for 60% of downtime cost but have no condition monitoring whatsoever. These two plants operate on a fully reactive maintenance model — equipment runs until it fails. They are the clear priority for predictive maintenance deployment.\\n\\n","fontSize":11,"color":"cbd5e0"},{"text":"Derby and Sheffield have some planned maintenance in place and can be addressed in Phase 3 once the approach is proven at the worst-performing sites.","fontSize":11,"color":"a0aec0"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"OEE_Performance_Dashboard_H1_FY2024-25.md","location":{"section":"Group OEE Summary","excerpt":"| **Group Average** | **81.0%** | **91.3%** | **97.9%** | **72.0%** |"}},{"url":"COO_Interview_Jan2025.md","location":{"section":"Interview Transcript","excerpt":"We fix things when they break. That\'s the mindset, particularly at Coventry and Sunderland."}},{"url":"Maintenance_Cost_Analysis_FY2023-24.md","location":{"section":"Implications and Observations","excerpt":"a potential reduction in unplanned downtime costs of £3M to £4M per year at scale"}}]},{"id":"pm-logo-2","type":"shape","shapeType":"rectangle","x":11.83,"y":6.9,"w":1,"h":0.4,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/whitmore-keane-consulting.svg","sizing":"contain"}}]},{"label":"From Reactive to Predictive","elements":[{"id":"pm-darkbg-4","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":13.33,"h":7.5,"fill":{"type":"solid","color":"1a202c"}},{"id":"pm-header-4","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"From Reactive to Predictive","fontSize":28,"bold":true,"color":"ffffff"}],"style":{"align":"left","valign":"bottom"}},{"id":"pm-line-4","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"4a5568"}},{"id":"pm-phase-4a","type":"shape","shapeType":"rounded-rect","x":0.5,"y":1.5,"w":3.78,"h":3.6,"fill":{"type":"solid","color":"2d3748"},"stroke":{"width":1,"color":"4a5568","style":"solid"},"textRuns":[{"text":"Phase 1\\n","fontSize":11,"bold":true,"color":"e55c30"},{"text":"Instrument\\n","fontSize":16,"bold":true,"color":"ffffff"},{"text":"Q1–Q2 FY2025-26\\n\\n","fontSize":10,"color":"a0aec0"},{"text":"• Deploy vibration sensors on CNC spindles across Coventry and Sunderland\\n• Install condition monitoring on hydraulic presses\\n• Connect machine data to central IoT platform\\n• Baseline current failure patterns","fontSize":11,"color":"cbd5e0"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"CTO_Interview_Jan2025.md","location":{"section":"Interview Transcript","excerpt":"vibration sensors on CNC spindles across the fleet — this is the fastest payback"}},{"url":"IT_Systems_Landscape_2024.md","location":{"section":"Manufacturing Execution Systems (MES)","excerpt":"Sheffield, Derby, Sunderland have no MES capability, and machine condition data is collected through manual operator logging"}}]},{"id":"pm-phase-4b","type":"shape","shapeType":"rounded-rect","x":4.62,"y":1.5,"w":3.78,"h":3.6,"fill":{"type":"solid","color":"2d3748"},"stroke":{"width":1,"color":"4a5568","style":"solid"},"textRuns":[{"text":"Phase 2\\n","fontSize":11,"bold":true,"color":"e55c30"},{"text":"Predict\\n","fontSize":16,"bold":true,"color":"ffffff"},{"text":"Q3–Q4 FY2025-26\\n\\n","fontSize":10,"color":"a0aec0"},{"text":"• Train ML models on vibration and temperature data\\n• Automated alerts before predicted failure\\n• Integrate with maintenance scheduling system\\n• Target: 48-hour advance warning on spindle failures","fontSize":11,"color":"cbd5e0"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Industry_4.0_Benchmarking_Report.md","location":{"section":"Conclusions and Recommendations","excerpt":"VPE\'s Industry 4.0 position represents a meaningful underinvestment relative to sector peers"}},{"url":"CTO_Interview_Jan2025.md","location":{"section":"Interview Transcript","excerpt":"three of our four plants have no machine connectivity at all. The data collection is manual."}}]},{"id":"pm-phase-4c","type":"shape","shapeType":"rounded-rect","x":8.74,"y":1.5,"w":4.09,"h":3.6,"fill":{"type":"solid","color":"2d3748"},"stroke":{"width":1,"color":"4a5568","style":"solid"},"textRuns":[{"text":"Phase 3\\n","fontSize":11,"bold":true,"color":"e55c30"},{"text":"Scale\\n","fontSize":16,"bold":true,"color":"ffffff"},{"text":"Year 2 (FY2026-27)\\n\\n","fontSize":10,"color":"a0aec0"},{"text":"• Roll out proven models from Coventry/Sunderland to Sheffield and Derby\\n• Integrate with MES for full OEE visibility\\n• Extend to additional equipment classes (press brakes, HVAC)\\n• Cross-plant benchmarking dashboard","fontSize":11,"color":"cbd5e0"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Precision_2030_Strategy_Summary.md","location":{"section":"Pillar 1: Operational Excellence & Lean Maturity","excerpt":"Reduce unplanned downtime cost from £8.2M to below £3M by FY2027–28"}},{"url":"Industry_4.0_Benchmarking_Report.md","location":{"section":"Conclusions and Recommendations","excerpt":"MES rollout beyond Coventry — providing production visibility and data capture at Sheffield, Derby, and Sunderland"}}]},{"id":"pm-prereq-4","type":"shape","shapeType":"rounded-rect","x":0.5,"y":5.4,"w":12.33,"h":1.6,"fill":{"type":"solid","color":"2d2b1a"},"stroke":{"width":1,"color":"4a4520","style":"solid"},"textRuns":[{"text":"Prerequisite: MES Deployment\\n\\n","fontSize":13,"bold":true,"color":"d69e2e"},{"text":"Coventry and Sunderland currently track production using paper job cards and Excel. MES deployment at these two sites provides the data backbone for predictive maintenance — without it, there is no machine connectivity to feed the models. The MES pilot is already scoped within Precision 2030 and should be accelerated to run in parallel with sensor deployment.","fontSize":11,"color":"cbd5e0"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"IT_Systems_Landscape_2024.md","location":{"section":"Manufacturing Execution Systems (MES)","excerpt":"All three plants track production using a combination of paper job cards, whiteboard scheduling, and Microsoft Excel."}},{"url":"Precision_2030_Strategy_Summary.md","location":{"section":"Investment Envelope","excerpt":"Total investment: **£45 million over 5 years (FY2024–25 to FY2028–29)**"}}]},{"id":"pm-logo-3","type":"shape","shapeType":"rectangle","x":11.83,"y":6.9,"w":1,"h":0.4,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/whitmore-keane-consulting.svg","sizing":"contain"}}]},{"label":"Investment Case","elements":[{"id":"pm-darkbg-5","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":13.33,"h":7.5,"fill":{"type":"solid","color":"1a202c"}},{"id":"pm-header-5","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"Investment Case","fontSize":28,"bold":true,"color":"ffffff"}],"style":{"align":"left","valign":"bottom"}},{"id":"pm-line-5","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"4a5568"}},{"id":"pm-invest-5a","type":"shape","shapeType":"rounded-rect","x":0.5,"y":1.5,"w":5.9,"h":3.6,"fill":{"type":"solid","color":"2d3748"},"stroke":{"width":1,"color":"4a5568","style":"solid"},"textRuns":[{"text":"Investment Breakdown\\n\\n","fontSize":16,"bold":true,"color":"ffffff"},{"text":"Year 1 — £2.8M\\n","fontSize":12,"bold":true,"color":"e55c30"},{"text":"Vibration/temperature sensors, MES pilot at Coventry & Sunderland, IoT data platform, initial ML model development\\n\\n","fontSize":11,"color":"cbd5e0"},{"text":"Year 2 — £2.2M\\n","fontSize":12,"bold":true,"color":"e55c30"},{"text":"ML model refinement and scaling, rollout to Sheffield & Derby, MES integration, cross-plant dashboard\\n\\n","fontSize":11,"color":"cbd5e0"},{"text":"Total: £5.0M\\n","fontSize":13,"bold":true,"color":"ffffff"},{"text":"From existing £45M Precision 2030 envelope","fontSize":11,"color":"a0aec0"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Capex_Plan_FY2024-2027.md","location":{"section":"Three-Year Investment Outlook","excerpt":"Digital manufacturing (IoT, MES, data platform) | 1.5 | 6.5 | 5.0"}},{"url":"Precision_2030_Strategy_Summary.md","location":{"section":"Investment Envelope","excerpt":"Total investment: **£45 million over 5 years (FY2024–25 to FY2028–29)**"}}]},{"id":"pm-returns-5b","type":"shape","shapeType":"rounded-rect","x":6.9,"y":1.5,"w":5.93,"h":3.6,"fill":{"type":"solid","color":"2d3748"},"stroke":{"width":1,"color":"4a5568","style":"solid"},"textRuns":[{"text":"Expected Returns (Annual, at Scale)\\n\\n","fontSize":16,"bold":true,"color":"ffffff"},{"text":"40% reduction in unplanned downtime\\n","fontSize":11,"bold":true,"color":"cbd5e0"},{"text":"= £3.3M annual saving\\n\\n","fontSize":12,"bold":true,"color":"e55c30"},{"text":"OTD improvement reduces penalty risk\\n","fontSize":11,"bold":true,"color":"cbd5e0"},{"text":"= £1.2–1.8M avoided\\n\\n","fontSize":12,"bold":true,"color":"e55c30"},{"text":"Scrap reduction from better process control\\n","fontSize":11,"bold":true,"color":"cbd5e0"},{"text":"= £0.8M saving\\n\\n","fontSize":12,"bold":true,"color":"e55c30"},{"text":"Total annual benefit: £5.3–5.9M\\nPayback: 10–12 months from first deployment","fontSize":13,"bold":true,"color":"ffffff"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Maintenance_Cost_Analysis_FY2023-24.md","location":{"section":"Implications and Observations","excerpt":"a potential reduction in unplanned downtime costs of £3M to £4M per year at scale"}},{"url":"Board_Paper_Q3_2024_Operations_Review.md","location":{"section":"Executive Summary","excerpt":"Group OTD of 91.3% against a 98% target represents a persistent gap that is generating commercial risk with key customers"}}]},{"id":"pm-callout-5","type":"shape","shapeType":"rounded-rect","x":0.5,"y":5.4,"w":12.33,"h":1.6,"fill":{"type":"solid","color":"2d3748"},"stroke":{"width":2,"color":"e55c30","style":"solid"},"textRuns":[{"text":"The COO\'s View\\n\\n","fontSize":13,"bold":true,"color":"e55c30"},{"text":"Predictive maintenance is the fastest payback in the Precision 2030 programme. Start with the two worst-performing plants, prove the model, then scale. The £5M investment pays for itself within the first year of full operation — and the operational discipline it introduces underpins every other improvement initiative in the strategy.","fontSize":11,"color":"cbd5e0"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Precision_2030_Strategy_Summary.md","location":{"section":"Pillar 1: Operational Excellence & Lean Maturity","excerpt":"Reduce unplanned downtime cost from £8.2M to below £3M by FY2027–28"}},{"url":"Capex_Plan_FY2024-2027.md","location":{"section":"Three-Year Investment Outlook","excerpt":"Digital manufacturing (IoT, MES, data platform) | 1.5 | 6.5 | 5.0"}},{"url":"Board_Paper_Q3_2024_Operations_Review.md","location":{"section":"Executive Summary","excerpt":"Group OTD of 91.3% against a 98% target represents a persistent gap that is generating commercial risk with key customers"}},{"url":"Maintenance_Cost_Analysis_FY2023-24.md","location":{"section":"Implications and Observations","excerpt":"a potential reduction in unplanned downtime costs of £3M to £4M per year at scale"}}]},{"id":"pm-logo-4","type":"shape","shapeType":"rectangle","x":11.83,"y":6.9,"w":1,"h":0.4,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/whitmore-keane-consulting.svg","sizing":"contain"}}]}]')},261462,(e,t,o)=>{t.exports=JSON.parse('[{"label":"Workshop Title","elements":[{"id":"ws-bg-1","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":13.33,"h":7.5,"fill":{"type":"solid","color":"2c5282"}},{"id":"ws-accent-1","type":"line","x":0.8,"y":4.5,"w":5,"h":0,"style":{"borderWidth":3,"borderColor":"63b3ed"}},{"id":"ws-tag-1","type":"shape","shapeType":"rounded-rect","x":0.8,"y":1.4,"w":3.2,"h":0.5,"fill":{"type":"solid","color":"63b3ed"},"textRuns":[{"text":"WORKING SESSION","fontSize":12,"bold":true,"color":"ffffff"}],"style":{"align":"center","valign":"middle"}},{"id":"ws-title-1","type":"shape","x":0.8,"y":2.2,"w":11.73,"h":2,"textRuns":[{"text":"Omnichannel Strategy\\nWorkshop","fontSize":40,"bold":true,"color":"ffffff"}],"style":{"align":"left","valign":"top"}},{"id":"ws-subtitle-1","type":"shape","x":0.8,"y":4.8,"w":11.73,"h":0.6,"textRuns":[{"text":"Pemberton Retail Group — Strategy Session","fontSize":18,"color":"a0aec0"}],"style":{"align":"left"}},{"id":"ws-footer-1","type":"shape","x":0.8,"y":5.8,"w":11.73,"h":0.8,"textRuns":[{"text":"Prepared by Langley Hart Consulting LLP  |  March 2025","fontSize":13,"color":"718096"}],"style":{"align":"left"}},{"id":"ws-logo-1","type":"shape","shapeType":"rectangle","x":0.5,"y":0.5,"w":2.5,"h":1.0,"fill":{"type":"image","src":"/demo-logos/langley-hart-consulting.svg","sizing":"contain"}}]},{"label":"Where We Are Today","elements":[{"id":"ws-leftbar-2","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":0.15,"h":7.5,"fill":{"type":"solid","color":"63b3ed"}},{"id":"ws-header-2","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"Where We Are Today","fontSize":28,"bold":true,"color":"2c5282"}],"style":{"align":"left","valign":"bottom"}},{"id":"ws-line-2","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"e2e8f0"}},{"id":"ws-kpi-2a","type":"shape","shapeType":"rounded-rect","x":0.5,"y":1.5,"w":2.88,"h":1.6,"fill":{"type":"solid","color":"f0fff4"},"stroke":{"width":1,"color":"c6f6d5","style":"solid"},"textRuns":[{"text":"£280M\\n","fontSize":28,"bold":true,"color":"276749"},{"text":"Group\\nRevenue","fontSize":11,"color":"276749"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Annual_Report_2023-2024.md","location":{"section":"Financial Highlights","excerpt":"Revenue | £280.0M | £271.5M (est.)"}}]},{"id":"ws-kpi-2b","type":"shape","shapeType":"rounded-rect","x":3.72,"y":1.5,"w":2.88,"h":1.6,"fill":{"type":"solid","color":"fff5f5"},"stroke":{"width":1,"color":"fed7d7","style":"solid"},"textRuns":[{"text":"8.0%\\n","fontSize":28,"bold":true,"color":"c53030"},{"text":"EBITDA Margin\\n","fontSize":11,"color":"c53030"},{"text":"declining from 9.5%","fontSize":10,"color":"fc8181"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Annual_Report_2023-2024.md","location":{"section":"Chairman\'s Statement","excerpt":"EBITDA declined to £22.4 million, representing an 8.0% margin, compared with £26.6 million and 9.5% in the prior year"}}]},{"id":"ws-kpi-2c","type":"shape","shapeType":"rounded-rect","x":6.94,"y":1.5,"w":2.88,"h":1.6,"fill":{"type":"solid","color":"f0fff4"},"stroke":{"width":1,"color":"c6f6d5","style":"solid"},"textRuns":[{"text":"+18%\\n","fontSize":28,"bold":true,"color":"276749"},{"text":"Online\\nGrowth YoY","fontSize":11,"color":"276749"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Annual_Report_2023-2024.md","location":{"section":"Chief Executive\'s Strategic Review","excerpt":"Online revenue grew approximately 18% year-on-year, reaching £61.6 million"}}]},{"id":"ws-kpi-2d","type":"shape","shapeType":"rounded-rect","x":10.16,"y":1.5,"w":2.67,"h":1.6,"fill":{"type":"solid","color":"fffff0"},"stroke":{"width":1,"color":"fefcbf","style":"solid"},"textRuns":[{"text":"42\\n","fontSize":28,"bold":true,"color":"975a16"},{"text":"NPS Score\\n","fontSize":11,"color":"975a16"},{"text":"declining from 48","fontSize":10,"color":"d69e2e"}],"style":{"align":"center","valign":"middle"},"sources":[{"url":"Customer_Satisfaction_Survey_H2_2024.md","location":{"section":"Overall Satisfaction","excerpt":"**Net Promoter Score (NPS)** for H2 2024 is **42**, down from 45 in H1 2024 and 48 two years ago"}},{"url":"Annual_Report_2023-2024.md","location":{"section":"Chief Executive\'s Strategic Review","excerpt":"Our Net Promoter Score of 42 remains above the sector average of 38"}}]},{"id":"ws-working-2a","type":"shape","shapeType":"rounded-rect","x":0.5,"y":3.4,"w":5.93,"h":3.6,"fill":{"type":"solid","color":"f0fff4"},"stroke":{"width":1,"color":"c6f6d5","style":"solid"},"textRuns":[{"text":"What\'s Working\\n\\n","fontSize":15,"bold":true,"color":"276749"},{"text":"Online revenue growing 18% YoY — outpacing the market and now 22% of group revenue\\n\\nLoyalty programme at 1.8M members — a significant customer asset, even if underutilised\\n\\nRetail park format outperforming high street on revenue per sq ft and footfall trends\\n\\nBrand strength remains strong — NPS of 42 still above sector average of 38","fontSize":11,"color":"4a5568"}],"style":{"align":"left","valign":"top","padding":10},"sources":[{"url":"Annual_Report_2023-2024.md","location":{"section":"Chief Executive\'s Strategic Review","excerpt":"Online revenue grew approximately 18% year-on-year, reaching £61.6 million"}},{"url":"Annual_Report_2023-2024.md","location":{"section":"Store Performance and Portfolio","excerpt":"Our 120 stores — 85 high street format and 35 retail park format — serve different customer missions"}}]},{"id":"ws-notwk-2b","type":"shape","shapeType":"rounded-rect","x":6.9,"y":3.4,"w":5.93,"h":3.6,"fill":{"type":"solid","color":"fff5f5"},"stroke":{"width":1,"color":"fed7d7","style":"solid"},"textRuns":[{"text":"What\'s Not\\n\\n","fontSize":15,"bold":true,"color":"c53030"},{"text":"Click-and-collect fulfilment averaging 6.2 hours vs. 2-hour target — customers are noticing\\n\\nInventory accuracy at 92% vs. 97% industry benchmark — driving margin leakage and lost sales\\n\\nPOS system crashing 2-3x per week per store — staff workarounds becoming the norm\\n\\nNo unified customer view — loyalty, e-commerce, and in-store data sit in separate silos","fontSize":11,"color":"4a5568"}],"style":{"align":"left","valign":"top","padding":10},"sources":[{"url":"Customer_Satisfaction_Survey_H2_2024.md","location":{"section":"Overall Satisfaction","excerpt":"**Net Promoter Score (NPS)** for H2 2024 is **42**, down from 45 in H1 2024 and 48 two years ago"}},{"url":"Systems_Inventory_2024.md","location":{"section":"SAP ECC 6.0","excerpt":"the 15-45 minute order-to-SAP sync latency causing inventory discrepancies visible to store staff"}},{"url":"Annual_Report_2023-2024.md","location":{"section":"Chief Executive\'s Strategic Review","excerpt":"Inventory accuracy at approximately 92% compares poorly with industry best practice of 97% or better"}}]},{"id":"ws-logo-2","type":"shape","shapeType":"rectangle","x":11.83,"y":6.9,"w":1.0,"h":0.4,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/langley-hart-consulting.svg","sizing":"contain"}}]},{"label":"The Omnichannel Gap","elements":[{"id":"ws-leftbar-3","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":0.15,"h":7.5,"fill":{"type":"solid","color":"63b3ed"}},{"id":"ws-header-3","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"Discussion: Where\'s the Biggest Gap?","fontSize":28,"bold":true,"color":"2c5282"}],"style":{"align":"left","valign":"bottom"}},{"id":"ws-line-3","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"e2e8f0"}},{"id":"ws-table-3","type":"table","x":0.5,"y":1.5,"w":12.33,"h":3.5,"tableData":{"rows":[{"cells":[{"text":"Capability","textRuns":[{"text":"Capability","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Current State","textRuns":[{"text":"Current State","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Peer Benchmark","textRuns":[{"text":"Peer Benchmark","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Target (FY2027)","textRuns":[{"text":"Target (FY2027)","bold":true,"fontSize":11,"color":"ffffff"}]},{"text":"Priority","textRuns":[{"text":"Priority","bold":true,"fontSize":11,"color":"ffffff"}]}]},{"cells":[{"text":"Inventory Accuracy","textRuns":[{"text":"Inventory Accuracy","fontSize":11}]},{"text":"92%","textRuns":[{"text":"92%","fontSize":11,"color":"c53030"}]},{"text":"97%+","textRuns":[{"text":"97%+","fontSize":11}]},{"text":"97%","textRuns":[{"text":"97%","fontSize":11}]},{"text":"Critical","textRuns":[{"text":"Critical","fontSize":11,"color":"c53030","bold":true}]}]},{"cells":[{"text":"Click & Collect SLA","textRuns":[{"text":"Click & Collect SLA","fontSize":11}]},{"text":"6.2 hours","textRuns":[{"text":"6.2 hours","fontSize":11,"color":"c53030"}]},{"text":"2 hours","textRuns":[{"text":"2 hours","fontSize":11}]},{"text":"2 hours","textRuns":[{"text":"2 hours","fontSize":11}]},{"text":"Critical","textRuns":[{"text":"Critical","fontSize":11,"color":"c53030","bold":true}]}]},{"cells":[{"text":"Customer Data Platform","textRuns":[{"text":"Customer Data Platform","fontSize":11}]},{"text":"None","textRuns":[{"text":"None","fontSize":11,"color":"c53030"}]},{"text":"Unified CDP","textRuns":[{"text":"Unified CDP","fontSize":11}]},{"text":"Deployed","textRuns":[{"text":"Deployed","fontSize":11}]},{"text":"High","textRuns":[{"text":"High","fontSize":11,"color":"d69e2e","bold":true}]}]},{"cells":[{"text":"Online Revenue %","textRuns":[{"text":"Online Revenue %","fontSize":11}]},{"text":"22%","textRuns":[{"text":"22%","fontSize":11,"color":"276749"}]},{"text":"25-30%","textRuns":[{"text":"25-30%","fontSize":11}]},{"text":"30%","textRuns":[{"text":"30%","fontSize":11}]},{"text":"Medium","textRuns":[{"text":"Medium","fontSize":11,"color":"d69e2e","bold":true}]}]},{"cells":[{"text":"Loyalty Data Activation","textRuns":[{"text":"Loyalty Data Activation","fontSize":11}]},{"text":"Basic","textRuns":[{"text":"Basic","fontSize":11,"color":"d69e2e"}]},{"text":"Personalised","textRuns":[{"text":"Personalised","fontSize":11}]},{"text":"Segmented","textRuns":[{"text":"Segmented","fontSize":11}]},{"text":"High","textRuns":[{"text":"High","fontSize":11,"color":"d69e2e","bold":true}]}]},{"cells":[{"text":"Staff Satisfaction","textRuns":[{"text":"Staff Satisfaction","fontSize":11}]},{"text":"67%","textRuns":[{"text":"67%","fontSize":11,"color":"d69e2e"}]},{"text":"75%+","textRuns":[{"text":"75%+","fontSize":11}]},{"text":"75%","textRuns":[{"text":"75%","fontSize":11}]},{"text":"Medium","textRuns":[{"text":"Medium","fontSize":11,"color":"d69e2e","bold":true}]}]}],"headerRow":true,"headerStyle":{"backgroundColor":"2c5282"}},"sources":[{"url":"Digital_Commerce_Strategy_2025-2028.md","location":{"section":"KPIs and Targets","excerpt":"Click-and-Collect Fulfillment Time | 6.2 hours | 3.0 hours | 2.0 hours"}},{"url":"Retail_Industry_Technology_Benchmark_2024.md","location":{"section":"Inventory Technology — RFID","excerpt":"the average reported inventory accuracy improvement is from approximately 90-92% pre-implementation to **95-98% post-implementation**"}},{"url":"Annual_Report_2023-2024.md","location":{"section":"Chief Executive\'s Strategic Review","excerpt":"Inventory accuracy at approximately 92% compares poorly with industry best practice of 97% or better"}},{"url":"Staff_Survey_Results_2024.md","location":{"section":"Overview","excerpt":"Overall engagement score: 67%"}}]},{"id":"ws-discussion-3","type":"shape","shapeType":"rounded-rect","x":0.5,"y":5.3,"w":12.33,"h":1.7,"fill":{"type":"solid","color":"ebf8ff"},"textRuns":[{"text":"For this workshop:  ","fontSize":13,"bold":true,"color":"2c5282"},{"text":"Which of these gaps is costing us the most today?  Which has the fastest payback?  Where do our competitors already have an edge?","fontSize":13,"italic":true,"color":"4a7ab5"}],"style":{"align":"left","valign":"middle","padding":14},"sources":[{"url":"Digital_Commerce_Strategy_2025-2028.md","location":{"section":"Customer Data: The Single Biggest Constraint","excerpt":"We have **1.8 million loyalty programme members.** This is a significant asset. The problem is that we cannot use it as one."}},{"url":"Retail_Industry_Technology_Benchmark_2024.md","location":{"section":"Inventory Technology — RFID","excerpt":"the average reported inventory accuracy improvement is from approximately 90-92% pre-implementation to **95-98% post-implementation**"}}]},{"id":"ws-logo-3","type":"shape","shapeType":"rectangle","x":11.83,"y":6.9,"w":1.0,"h":0.4,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/langley-hart-consulting.svg","sizing":"contain"}}]},{"label":"Options on the Table","elements":[{"id":"ws-leftbar-4","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":0.15,"h":7.5,"fill":{"type":"solid","color":"63b3ed"}},{"id":"ws-header-4","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"Three Approaches — What\'s Right for Pemberton?","fontSize":28,"bold":true,"color":"2c5282"}],"style":{"align":"left","valign":"bottom"}},{"id":"ws-line-4","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"e2e8f0"}},{"id":"ws-optA-4","type":"shape","shapeType":"rounded-rect","x":0.5,"y":1.5,"w":3.94,"h":3.8,"fill":{"type":"solid","color":"ebf8ff"},"stroke":{"width":2,"color":"63b3ed","style":"solid"},"textRuns":[{"text":"A","fontSize":22,"bold":true,"color":"63b3ed"},{"text":"  Fix the Foundations First\\n\\n","fontSize":14,"bold":true,"color":"2c5282"},{"text":"POS replacement + inventory accuracy programme. Addresses the most visible staff pain and the worst customer-facing SLA failures.\\n\\n","fontSize":11,"color":"4a5568"},{"text":"£3M  |  Lower risk\\n\\n","fontSize":12,"bold":true,"color":"276749"},{"text":"Trade-off: ","fontSize":10,"bold":true,"color":"c53030"},{"text":"Doesn\'t solve the customer data problem. Loyalty and personalisation wait until Phase 2.","fontSize":10,"color":"718096"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Technology_Transformation_Roadmap_2024.md","location":{"section":"Phase 1 — 2025: Foundation","excerpt":"POS vendor selection and contract award"}},{"url":"Board_Paper_Q3_2024_Technology_Review.md","location":{"section":"Programme Overview","excerpt":"a three-year Technology Modernisation Programme with a total investment envelope of £18 million"}}]},{"id":"ws-optB-4","type":"shape","shapeType":"rounded-rect","x":4.69,"y":1.5,"w":3.94,"h":3.8,"fill":{"type":"solid","color":"ebf8ff"},"stroke":{"width":2,"color":"63b3ed","style":"solid"},"textRuns":[{"text":"B","fontSize":22,"bold":true,"color":"63b3ed"},{"text":"  Customer Data First\\n\\n","fontSize":14,"bold":true,"color":"2c5282"},{"text":"CDP deployment + loyalty integration. Unlocks personalisation revenue and gives us the customer insight we\'re currently blind to.\\n\\n","fontSize":11,"color":"4a5568"},{"text":"£4M  |  Medium risk\\n\\n","fontSize":12,"bold":true,"color":"975a16"},{"text":"Trade-off: ","fontSize":10,"bold":true,"color":"c53030"},{"text":"Still on creaking POS infrastructure. Staff frustration continues. Click-and-collect stays broken.","fontSize":10,"color":"718096"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Digital_Commerce_Strategy_2025-2028.md","location":{"section":"Customer Data: The Single Biggest Constraint","excerpt":"We have **1.8 million loyalty programme members.** This is a significant asset. The problem is that we cannot use it as one."}},{"url":"Vendor_Demo_Debrief_ERP_Jan2025.md","location":{"section":"Meeting Transcript","excerpt":"Three vendor demonstrations were conducted over the previous week: SAP S/4HANA (presented by implementation partner Capstone Consulting), Microsoft Dynamics 365 (presented directly)"}}]},{"id":"ws-optC-4","type":"shape","shapeType":"rounded-rect","x":8.89,"y":1.5,"w":3.94,"h":3.8,"fill":{"type":"solid","color":"ebf8ff"},"stroke":{"width":2,"color":"63b3ed","style":"solid"},"textRuns":[{"text":"C","fontSize":22,"bold":true,"color":"63b3ed"},{"text":"  Big Bang Platform\\n\\n","fontSize":14,"bold":true,"color":"2c5282"},{"text":"ERP + POS + CDP deployed together as a unified platform. Maximum impact, single migration event, one integration effort.\\n\\n","fontSize":11,"color":"4a5568"},{"text":"£12M Year 1  |  Highest risk\\n\\n","fontSize":12,"bold":true,"color":"c53030"},{"text":"Trade-off: ","fontSize":10,"bold":true,"color":"c53030"},{"text":"Longest timeline, heaviest change management burden, and front-loads most of the £18M budget.","fontSize":10,"color":"718096"}],"style":{"align":"left","valign":"top","padding":12},"sources":[{"url":"Technology_Transformation_Roadmap_2024.md","location":{"section":"The Legacy Estate","excerpt":"Pemberton\'s core technology infrastructure has not had a major investment cycle since the SAP ECC 6.0 implementation in 2011"}},{"url":"CFO_Interview_Jan2025.md","location":{"section":"Interview Transcript","excerpt":"I want to see even, disciplined spend with clear value gates at each phase — points where we can genuinely say \\"this phase delivered what it promised\\" before committing to the next."}}]},{"id":"ws-sequencing-4","type":"shape","shapeType":"rounded-rect","x":0.5,"y":5.6,"w":12.33,"h":1.4,"fill":{"type":"solid","color":"fffff0"},"stroke":{"width":1,"color":"fefcbf","style":"solid"},"textRuns":[{"text":"The board approved £18M over 3 years. The question isn\'t budget — it\'s sequencing.\\n","fontSize":14,"bold":true,"color":"2c5282"},{"text":"Each option can lead into the others. The real decision is what we prioritise in Year 1 — and what we\'re willing to live with while we build.","fontSize":11,"color":"4a5568"}],"style":{"align":"center","valign":"middle","padding":12},"sources":[{"url":"Board_Paper_Q3_2024_Technology_Review.md","location":{"section":"Board Decision","excerpt":"**Approved** the £18 million Technology Modernisation Programme over three years, subject to annual budget reconfirmation at each year-end."}},{"url":"Investor_Presentation_H2_2024.md","location":{"section":"Technology Programme: What Was Approved and Why","excerpt":"The Board\'s approval of the £18 million programme reflects a clear-eyed assessment that deferral carries a higher cost than investment."}}]},{"id":"ws-logo-4","type":"shape","shapeType":"rectangle","x":11.83,"y":6.9,"w":1.0,"h":0.4,"opacity":0.6,"fill":{"type":"image","src":"/demo-logos/langley-hart-consulting.svg","sizing":"contain"}}]},{"label":"Open Questions","elements":[{"id":"ws-leftbar-5","type":"shape","shapeType":"rectangle","x":0,"y":0,"w":0.15,"h":7.5,"fill":{"type":"solid","color":"63b3ed"}},{"id":"ws-header-5","type":"shape","x":0.5,"y":0.3,"w":12.33,"h":0.8,"textRuns":[{"text":"Questions for This Session","fontSize":28,"bold":true,"color":"2c5282"}],"style":{"align":"left","valign":"bottom"}},{"id":"ws-line-5","type":"line","x":0.5,"y":1.2,"w":12.33,"h":0,"style":{"borderWidth":1.5,"borderColor":"e2e8f0"}},{"id":"ws-q1-5","type":"shape","shapeType":"rounded-rect","x":0.8,"y":1.5,"w":11.73,"h":0.75,"fill":{"type":"solid","color":"f7fafc"},"textRuns":[{"text":"1.  ","fontSize":14,"bold":true,"color":"63b3ed"},{"text":"RetailPoint hits end-of-life in December. Is POS replacement actually optional?","fontSize":14,"color":"2d3748"}],"style":{"align":"left","valign":"middle","padding":10},"sources":[{"url":"Systems_Inventory_2024.md","location":{"section":"RetailPoint v6","excerpt":"**End-of-Life December 2025.** Vendor support post-EOL unconfirmed following Apex acquisition."}}]},{"id":"ws-q2-5","type":"shape","shapeType":"rounded-rect","x":0.8,"y":2.4,"w":11.73,"h":0.75,"fill":{"type":"solid","color":"f7fafc"},"textRuns":[{"text":"2.  ","fontSize":14,"bold":true,"color":"63b3ed"},{"text":"The 1.8M loyalty members are an untapped asset. How long can we wait for a CDP?","fontSize":14,"color":"2d3748"}],"style":{"align":"left","valign":"middle","padding":10},"sources":[{"url":"Digital_Commerce_Strategy_2025-2028.md","location":{"section":"Customer Data: The Single Biggest Constraint","excerpt":"We have **1.8 million loyalty programme members.** This is a significant asset. The problem is that we cannot use it as one."}}]},{"id":"ws-q3-5","type":"shape","shapeType":"rounded-rect","x":0.8,"y":3.3,"w":11.73,"h":0.75,"fill":{"type":"solid","color":"f7fafc"},"textRuns":[{"text":"3.  ","fontSize":14,"bold":true,"color":"63b3ed"},{"text":"Retail park stores outperform high street. Should the tech roadmap reflect that?","fontSize":14,"color":"2d3748"}],"style":{"align":"left","valign":"middle","padding":10},"sources":[{"url":"Annual_Report_2023-2024.md","location":{"section":"Store Performance and Portfolio","excerpt":"Our 120 stores — 85 high street format and 35 retail park format — serve different customer missions"}}]},{"id":"ws-q4-5","type":"shape","shapeType":"rounded-rect","x":0.8,"y":4.2,"w":11.73,"h":0.75,"fill":{"type":"solid","color":"f7fafc"},"textRuns":[{"text":"4.  ","fontSize":14,"bold":true,"color":"63b3ed"},{"text":"The CFO wants phase gates with measurable milestones. What does \'success\' look like at Phase 1?","fontSize":14,"color":"2d3748"}],"style":{"align":"left","valign":"middle","padding":10},"sources":[{"url":"CFO_Interview_Jan2025.md","location":{"section":"Interview Transcript","excerpt":"I want to see even, disciplined spend with clear value gates at each phase — points where we can genuinely say \\"this phase delivered what it promised\\" before committing to the next."}}]},{"id":"ws-q5-5","type":"shape","shapeType":"rounded-rect","x":0.8,"y":5.1,"w":11.73,"h":0.75,"fill":{"type":"solid","color":"f7fafc"},"textRuns":[{"text":"5.  ","fontSize":14,"bold":true,"color":"63b3ed"},{"text":"Competitors are already personalising. What\'s the cost of waiting another year?","fontSize":14,"color":"2d3748"}],"style":{"align":"left","